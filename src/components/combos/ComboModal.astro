---
// src/components/combos/ComboModal.astro
import type { CollectionEntry } from 'astro:content';

interface Props {
  combo: CollectionEntry<'combos'>;
}

const { combo } = Astro.props;
---

<dialog 
  id={`modal-${combo.id}`}
  class="dialog-combo fixed inset-0 m-auto w-[92vw] max-w-2xl p-0 rounded-3xl backdrop:bg-slate-950/75 backdrop:backdrop-blur-xs bg-white dark:bg-[#130f24] text-slate-900 dark:text-white border border-slate-200 dark:border-purple-950 shadow-2xl overflow-hidden outline-none"
>
  <div class="relative w-full max-h-[85vh] flex flex-col">
    <!-- Botón Cerrar (Fijo en la esquina superior) -->
    <button 
      type="button" 
      data-close-modal={`modal-${combo.id}`}
      class="absolute top-5 right-5 sm:top-6 sm:right-6 w-9 h-9 rounded-full bg-slate-100/90 dark:bg-purple-950/90 text-slate-500 dark:text-purple-300 hover:bg-slate-200 dark:hover:bg-purple-900 flex items-center justify-center font-bold text-base cursor-pointer transition-colors z-30 shadow-xs backdrop-blur-xs"
      aria-label="Cerrar modal"
    >
      ✕
    </button>

    <!-- Contenedor con Scroll Interno Recortado -->
    <div class="dialog-scroll-content overflow-y-auto p-6 sm:p-8 md:p-10 space-y-6 md:space-y-8 max-h-[85vh]">
      <!-- Encabezado Modal -->
      <div class="border-b border-slate-100 dark:border-purple-950/60 pb-5 pr-10">
        <div class="flex items-center gap-3 mb-1.5">
          <span class="text-3xl sm:text-4xl">{combo.data.icono}</span>
          <h3 class="text-2xl sm:text-3xl font-black tracking-tight">{combo.data.nombre}</h3>
        </div>
        <p class="text-xs sm:text-sm text-purple-700 dark:text-purple-300 font-semibold leading-relaxed">{combo.data.subtitulo}</p>
      </div>

      <!-- Beneficios del Combo -->
      {combo.data.beneficios && combo.data.beneficios.length > 0 && (
        <div class="bg-purple-50/60 dark:bg-purple-950/30 p-5 sm:p-6 rounded-2xl border border-purple-100 dark:border-purple-900/40">
          <h4 class="text-xs sm:text-sm font-extrabold text-purple-950 dark:text-purple-300 uppercase tracking-wider mb-4 flex items-center gap-2">
            <span>✨</span> Beneficios Integrales del Protocolo
          </h4>
          <ul class="space-y-3 text-xs sm:text-sm text-slate-700 dark:text-purple-100">
            {combo.data.beneficios.map((ben) => (
              <li class="flex items-start gap-3">
                <span class="text-purple-600 dark:text-purple-400 font-black text-sm shrink-0">✓</span>
                <span class="leading-relaxed" set:html={ben} />
              </li>
            ))}
          </ul>
        </div>
      )}

      <!-- Recomendaciones Técnicas de Uso -->
      <div class="space-y-5">
        <h4 class="text-xs sm:text-sm font-extrabold text-slate-400 dark:text-slate-500 uppercase tracking-wider">
          📋 Recomendaciones Técnicas de Uso
        </h4>

        {combo.data.recomendaciones?.horarios && (
          <div class="bg-slate-50 dark:bg-purple-950/20 p-5 sm:p-6 rounded-2xl border border-slate-100 dark:border-purple-950/40 space-y-3">
            <span class="block text-xs sm:text-sm font-extrabold text-slate-900 dark:text-white uppercase tracking-wider">
              ⏰ Horarios y Tomas Sugeridas por Producto:
            </span>

            {Array.isArray(combo.data.recomendaciones.horarios) ? (
              <div class="space-y-2.5">
                {combo.data.recomendaciones.horarios.map((h) => {
                  const isObj = typeof h === 'object' && h !== null && 'producto' in h;
                  const nombreProducto = isObj ? h.producto : '';
                  const instruccionToma = isObj ? h.toma : h;

                  return (
                    <div class="bg-white dark:bg-[#18132e] p-3.5 sm:p-4 rounded-xl border border-slate-200/60 dark:border-purple-900/40 flex flex-col sm:flex-row sm:items-center justify-between gap-2 shadow-2xs">
                      {nombreProducto && (
                        <span class="font-black text-xs sm:text-sm text-purple-700 dark:text-purple-300 shrink-0 sm:w-1/3 flex items-center gap-1.5">
                          <span class="text-xs sm:text-sm">📌</span> {nombreProducto}
                        </span>
                      )}
                      <span class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed sm:w-2/3">
                        {instruccionToma}
                      </span>
                    </div>
                  );
                })}
              </div>
            ) : (
              <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
                {combo.data.recomendaciones.horarios}
              </p>
            )}
          </div>
        )}

        {combo.data.recomendaciones?.duracionEstimada && (
          <div class="bg-amber-50/70 dark:bg-amber-950/20 p-5 sm:p-6 rounded-2xl border border-amber-200/60 dark:border-amber-900/40 text-amber-950 dark:text-amber-200 text-xs sm:text-sm">
            <span class="block font-bold mb-1.5">📅 Rendimiento y Duración Estimada:</span>
            <p class="leading-relaxed">{combo.data.recomendaciones.duracionEstimada}</p>
          </div>
        )}

        {combo.data.recomendaciones?.tips && combo.data.recomendaciones.tips.length > 0 && (
          <div class="bg-slate-50 dark:bg-purple-950/20 p-5 sm:p-6 rounded-2xl border border-slate-100 dark:border-purple-950/40">
            <span class="block text-xs sm:text-sm font-bold text-slate-900 dark:text-white mb-3">💡 Tips Adicionales:</span>
            <ul class="space-y-2 text-xs sm:text-sm text-slate-600 dark:text-slate-300">
              {combo.data.recomendaciones.tips.map((tip) => (
                <li class="flex items-start gap-2.5">
                  <span class="text-amber-500 font-bold shrink-0">•</span>
                  <span class="leading-relaxed">{tip}</span>
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>

      <!-- Footer Modal -->
      <div class="pt-4 border-t border-slate-100 dark:border-purple-950/60 flex justify-end">
        <button 
          type="button" 
          data-close-modal={`modal-${combo.id}`}
          class="bg-slate-200 dark:bg-purple-900 hover:bg-slate-300 dark:hover:bg-purple-800 text-slate-800 dark:text-white font-extrabold px-6 py-2.5 rounded-xl text-xs sm:text-sm transition-colors cursor-pointer"
        >
          Cerrar
        </button>
      </div>
    </div>
  </div>
</dialog>

<style>
  /* Personalización limpia basada en estándares modernos W3C */
  .dialog-scroll-content {
    scrollbar-width: thin;
    scrollbar-color: rgba(147, 51, 234, 0.4) transparent;
  }
</style>