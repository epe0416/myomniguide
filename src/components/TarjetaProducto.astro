---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  slug: string;
  nombre: string;
  categorias: string[];
  beneficioPrincipal: string;
  formato: string;
  imagen?: ImageMetadata;
}

const { slug, nombre, categorias, beneficioPrincipal, formato, imagen } = Astro.props;

const rawBaseUrl = import.meta.env.BASE_URL;
const baseUrl = rawBaseUrl.endsWith('/') ? rawBaseUrl : `${rawBaseUrl}/`;
---

<article class="bg-white rounded-2xl border border-slate-200 shadow-xs hover:shadow-md transition-all flex flex-col justify-between overflow-hidden h-full">
  <!-- Contenedor de Imagen -->
  <div class="bg-slate-50 p-6 flex justify-center items-center h-48 border-b border-slate-100 shrink-0">
    {imagen ? (
      <Image 
        src={imagen} 
        alt={`Imagen del producto ${nombre}`} 
        class="max-h-full w-auto object-contain drop-shadow-xs"
        width={300}
        height={300}
      />
    ) : (
      <div class="text-slate-500 text-xs font-semibold">Sin imagen disponible</div>
    )}
  </div>

  <!-- Contenido de la Tarjeta -->
  <div class="p-6 flex flex-col flex-1 justify-between">
    <div>
      <!-- Insignias de Categorías -->
      <div class="flex flex-wrap gap-1 mb-3 min-h-[24px]">
        {categorias.map((cat) => (
          <span class="text-[10px] font-bold tracking-wider text-purple-900 bg-purple-100 px-2 py-0.5 rounded-md uppercase">
            {cat}
          </span>
        ))}
      </div>
      
      <h2 class="text-xl font-extrabold text-slate-950 mb-2">{nombre}</h2>
      
      <!-- Descripción con límite estricto de 2 líneas para simetría -->
      <p class="text-slate-700 text-sm leading-relaxed mb-4 line-clamp-2" title={beneficioPrincipal}>
        {beneficioPrincipal}
      </p>
    </div>
    
    <!-- Bloque inferior empujado al fondo de la tarjeta -->
    <div class="mt-auto">
      <div class="pt-4 border-t border-slate-100 flex items-center justify-between gap-2 mb-4 text-xs">
        <span class="text-slate-800 font-semibold bg-slate-100 px-2 py-1 rounded border border-slate-200/60">
          📦 {formato}
        </span>
      </div>

      <a 
        href={`${baseUrl}productos/${slug}`}
        aria-label={`Ver ficha completa de ${nombre}`}
        class="block w-full text-center bg-purple-800 hover:bg-purple-900 text-white font-bold py-2.5 px-4 rounded-lg text-sm transition-colors shadow-xs"
      >
        Ver ficha completa
      </a>
    </div>
  </div>
</article>