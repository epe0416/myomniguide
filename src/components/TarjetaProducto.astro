---
// src/components/TarjetaProducto.astro
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  slug: string;
  nombre: string;
  precioNIO?: number;
  precioUSD?: number;
  categorias?: string[];
  beneficioPrincipal?: string;
  formato: string;
  imagen?: ImageMetadata;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
}

const {
  slug,
  nombre,
  categorias = [],
  beneficioPrincipal = '',
  formato,
  imagen,
  loading = 'lazy',
  fetchpriority = 'auto',
} = Astro.props;

const rawBaseUrl = import.meta.env.BASE_URL;
const baseUrl = rawBaseUrl.endsWith('/') ? rawBaseUrl : `${rawBaseUrl}/`;

const beneficioLimpio = beneficioPrincipal.replace(/<\/?[^>]+(>|$)/g, '');
---

<a 
  href={`${baseUrl}productos/${slug}`}
  class="group bg-white dark:bg-[#130f24] rounded-3xl p-5 border border-slate-200/80 dark:border-purple-950/60 shadow-xs hover:shadow-md dark:hover:shadow-[0_0_25px_rgba(147,51,235,0.15)] hover:border-purple-200 dark:hover:border-purple-500/40 transition-all flex flex-col justify-between h-full"
>
  <div>
    <!-- Contenedor con dimensiones fijas para evitar CLS -->
    <div class="bg-slate-50 dark:bg-purple-950/20 rounded-2xl p-4 mb-4 flex justify-center items-center h-48 w-full overflow-hidden border border-slate-100 dark:border-purple-950/40">
      {imagen ? (
        <Image 
          src={imagen} 
          alt={nombre} 
          width={240}
          height={240}
          loading={loading}
          fetchpriority={fetchpriority}
          class="max-h-40 w-auto object-contain group-hover:scale-105 transition-transform duration-300 drop-shadow-sm" 
        />
      ) : (
        <span class="text-4xl">📦</span>
      )}
    </div>

    <!-- Categorías -->
    <div class="flex flex-wrap items-center justify-between gap-2 mb-2">
      <div class="flex flex-wrap gap-1">
        {(categorias ?? []).slice(0, 2).map((cat) => (
          <span class="text-[10px] font-bold text-purple-900 dark:text-purple-300 bg-purple-100 dark:bg-purple-950/80 px-2 py-0.5 rounded uppercase tracking-wider">
            {cat}
          </span>
        ))}
      </div>
    </div>

    <!-- Nombre y Beneficio -->
    <h3 class="text-lg font-black text-slate-950 dark:text-white group-hover:text-purple-900 dark:group-hover:text-purple-300 transition-colors mb-1 line-clamp-1">
      {nombre}
    </h3>
    <p class="text-xs text-slate-600 dark:text-slate-300 line-clamp-2 mb-4 leading-relaxed">
      {beneficioLimpio}
    </p>
  </div>

  <!-- Formato y Botón de Acción -->
  <div class="pt-3 border-t border-slate-100 dark:border-purple-950/50 flex flex-col gap-3 mt-auto">
    <div class="flex items-center justify-between text-xs text-slate-500 dark:text-slate-400 font-medium">
      <span>📦 {formato}</span>
    </div>
    
    <span class="block w-full text-center bg-purple-800 dark:bg-purple-700 group-hover:bg-purple-900 dark:group-hover:bg-purple-600 text-white font-bold py-2.5 px-4 rounded-xl text-xs sm:text-sm transition-colors shadow-xs">
      Ver ficha completa
    </span>
  </div>
</a>