---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  slug: string;
  nombre: string;
  categoria: string;
  beneficioPrincipal: string;
  formato: string;
  imagen?: ImageMetadata;
}

const { slug, nombre, categoria, beneficioPrincipal, formato, imagen } = Astro.props;

const rawBaseUrl = import.meta.env.BASE_URL;
const baseUrl = rawBaseUrl.endsWith('/') ? rawBaseUrl : `${rawBaseUrl}/`;
---

<article class="bg-white rounded-2xl border border-slate-200 shadow-xs hover:shadow-md transition-all flex flex-col justify-between overflow-hidden">
  <div class="bg-slate-50 p-6 flex justify-center items-center h-48 border-b border-slate-100">
    {imagen ? (
      <Image 
        src={imagen} 
        alt={`Imagen del producto ${nombre}`} 
        class="max-h-full w-auto object-contain drop-shadow-xs"
        width={300}
        height={300}
      />
    ) : (
      <div class="text-slate-500 text-xs font-semibold">Sin imagen disponible</div>
    )}
  </div>

  <div class="p-6 flex flex-col flex-1 justify-between">
    <div>
      <div class="flex justify-between items-start mb-2 gap-2">
        <span class="text-xs font-bold tracking-wider text-purple-800 uppercase">
          {categoria}
        </span>
        <!-- Contraste corregido: text-slate-800 sobre bg-slate-100 -->
        <span class="text-xs text-slate-800 font-semibold bg-slate-100 px-2 py-1 rounded border border-slate-200/60">
          {formato}
        </span>
      </div>
      
      <h2 class="text-xl font-extrabold text-slate-950 mb-2">{nombre}</h2>
      <p class="text-slate-700 text-sm leading-relaxed mb-4">{beneficioPrincipal}</p>
    </div>
    
    <a 
      href={`${baseUrl}productos/${slug}`}
      aria-label={`Ver ficha completa de ${nombre}`}
      class="block w-full text-center bg-purple-800 hover:bg-purple-900 text-white font-bold py-2.5 px-4 rounded-lg text-sm transition-colors shadow-xs"
    >
      Ver ficha completa
    </a>
  </div>
</article>