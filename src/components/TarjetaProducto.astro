---
// src/components/TarjetaProducto.astro
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { getProductoComercial } from '../data/inventario';
import PrecioBadge from './PrecioBadge.astro';

interface Props {
  slug: string;
  nombre: string;
  categorias?: string[];
  beneficioPrincipal?: string;
  formato: string;
  imagen?: ImageMetadata;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
}

const {
  slug,
  nombre,
  categorias = [],
  beneficioPrincipal = '',
  formato,
  imagen,
  loading = 'lazy',
  fetchpriority = 'auto',
} = Astro.props;

const rawBaseUrl = import.meta.env.BASE_URL;
const baseUrl = rawBaseUrl.endsWith('/') ? rawBaseUrl : `${rawBaseUrl}/`;

const beneficioLimpio = beneficioPrincipal.replace(/<\/?[^>]+(>|$)/g, '');

const comercial = getProductoComercial(slug);
const codigoSKU = comercial?.codigo;
const precioNIO = comercial?.nio?.precio;
const precioUSD = comercial?.usa?.precio;
const puntosNIO = comercial?.nio?.puntos;
const puntosUSD = comercial?.usa?.puntos;
const puntosIniciales = puntosNIO ?? puntosUSD ?? 0;

// Banderas de disponibilidad por región
const disponibleNIO = !!comercial?.nio;
const disponibleUSA = !!comercial?.usa;
---

<a 
  href={`${baseUrl}productos/${slug}`}
  class="group bg-white dark:bg-[#130f24] rounded-3xl p-5 border border-slate-200/80 dark:border-purple-950/60 shadow-xs hover:shadow-md dark:hover:shadow-[0_0_25px_rgba(147,51,235,0.15)] hover:border-purple-200 dark:hover:border-purple-500/45 transition-all flex flex-col justify-between h-full relative"
  data-has-nio={disponibleNIO ? "true" : "false"}
  data-has-usa={disponibleUSA ? "true" : "false"}
>
  {/* Badge de Puntos Flotante en la esquina superior derecha de la tarjeta */}
  {puntosIniciales > 0 && (
    <span 
      class="pts-badge text-xs font-black text-purple-950 dark:text-purple-200 bg-white/95 dark:bg-purple-950/95 px-3 py-1.5 rounded-xl border border-purple-200 dark:border-purple-900/50 shadow-md absolute top-3 right-3 z-20 backdrop-blur-xs"
      data-nio-pts={puntosNIO ? `💎 ${puntosNIO} PTS` : ''}
      data-usa-pts={puntosUSD ? `💎 ${puntosUSD} PTS` : ''}
    >
      <span class="pts-value">💎 {puntosIniciales} PTS</span>
    </span>
  )}

  <div>
    <!-- Contenedor de la Imagen -->
    <div class="bg-slate-50 dark:bg-purple-950/20 rounded-2xl p-4 mb-4 flex justify-center items-center h-48 w-full overflow-hidden border border-slate-100 dark:border-purple-950/40 relative">
      {imagen ? (
        <Image 
          src={imagen} 
          alt={nombre} 
          width={240}
          height={240}
          loading={loading}
          fetchpriority={fetchpriority}
          class="max-h-40 w-auto object-contain group-hover:scale-105 transition-transform duration-300 drop-shadow-sm" 
        />
      ) : (
        <span class="text-4xl">📦</span>
      )}
    </div>

    <!-- Categorías -->
    <div class="flex flex-wrap gap-1 mb-2">
      {(categorias ?? []).slice(0, 2).map((cat) => (
        <span class="text-[10px] font-bold text-purple-900 dark:text-purple-300 bg-purple-100 dark:bg-purple-950/80 px-2 py-0.5 rounded uppercase tracking-wider">
          {cat}
        </span>
      ))}
    </div>

    <!-- Nombre y Beneficio -->
    <h3 class="text-lg font-black text-slate-950 dark:text-white group-hover:text-purple-900 dark:group-hover:text-purple-300 transition-colors mb-1 line-clamp-1">
      {nombre}
    </h3>
    <p class="text-xs text-slate-600 dark:text-slate-300 line-clamp-2 mb-4 leading-relaxed">
      {beneficioLimpio}
    </p>
  </div>

  <!-- Formato, SKU, Precio y Botón de Acción -->
  <div class="pt-3 border-t border-slate-100 dark:border-purple-950/50 flex flex-col gap-2.5 mt-auto">
    <div class="flex items-center justify-between text-xs text-slate-500 dark:text-slate-400 font-medium">
      <span>📦 {formato}</span>
      {codigoSKU && (
        <span class="text-[10px] font-mono bg-slate-100 dark:bg-purple-950/40 px-1.5 py-0.5 rounded text-slate-500 dark:text-slate-400">
          SKU: {codigoSKU}
        </span>
      )}
    </div>

    {(precioNIO || precioUSD) && (
      <div class="flex items-center justify-between text-xs bg-emerald-50 dark:bg-emerald-950/30 border border-emerald-200/80 dark:border-emerald-900/50 px-2.5 py-1.5 rounded-xl">
        <span class="text-emerald-800 dark:text-emerald-400 font-bold">Precio:</span>
        <PrecioBadge precioNIO={precioNIO} precioUSD={precioUSD} clases="!text-xs font-black" />
      </div>
    )}
    
    <span class="block w-full text-center bg-purple-800 dark:bg-purple-700 group-hover:bg-purple-900 dark:group-hover:bg-purple-600 text-white font-bold py-2.5 px-4 rounded-xl text-xs sm:text-sm transition-colors shadow-xs">
      Ver ficha completa
    </span>
  </div>
</a>