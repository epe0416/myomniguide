---
// src/components/TarjetaProducto.astro
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  slug: string;
  nombre: string;
  precioNIO?: number;
  precioUSD?: number;
  categorias?: string[];
  beneficioPrincipal?: string;
  formato: string;
  imagen?: ImageMetadata;
}

const {
  slug,
  nombre,
  categorias = [],
  beneficioPrincipal = '',
  formato,
  imagen,
} = Astro.props;

const rawBaseUrl = import.meta.env.BASE_URL;
const baseUrl = rawBaseUrl.endsWith('/') ? rawBaseUrl : `${rawBaseUrl}/`;

// Limpiar etiquetas HTML (como <dfn>) para mostrar texto plano y limpio en la tarjeta
const beneficioLimpio = beneficioPrincipal.replace(/<\/?[^>]+(>|$)/g, '');
---

<a 
  href={`${baseUrl}productos/${slug}`}
  class="group bg-white rounded-3xl p-5 border border-slate-200/80 shadow-xs hover:shadow-md hover:border-purple-200 transition-all flex flex-col justify-between h-full"
>
  <div>
    <!-- Imagen del producto -->
    <div class="bg-slate-50 rounded-2xl p-4 mb-4 flex justify-center items-center h-48 w-full overflow-hidden border border-slate-100">
      {imagen ? (
        <Image 
          src={imagen} 
          alt={nombre} 
          width={240}
          height={240}
          class="max-h-40 w-auto object-contain group-hover:scale-105 transition-transform duration-300 drop-shadow-sm" 
        />
      ) : (
        <span class="text-4xl">📦</span>
      )}
    </div>

    <!-- Categorías -->
    <div class="flex flex-wrap items-center justify-between gap-2 mb-2">
      <div class="flex flex-wrap gap-1">
        {(categorias ?? []).slice(0, 2).map((cat) => (
          <span class="text-[10px] font-bold text-purple-900 bg-purple-100 px-2 py-0.5 rounded uppercase tracking-wider">
            {cat}
          </span>
        ))}
      </div>
    </div>

    <!-- Nombre y Beneficio -->
    <h3 class="text-lg font-black text-slate-950 group-hover:text-purple-900 transition-colors mb-1 line-clamp-1">
      {nombre}
    </h3>
    <p class="text-xs text-slate-600 line-clamp-2 mb-4 leading-relaxed">
      {beneficioLimpio}
    </p>
  </div>

  <!-- Formato y Botón de Acción -->
  <div class="pt-3 border-t border-slate-100 flex flex-col gap-3 mt-auto">
    <div class="flex items-center justify-between text-xs text-slate-500 font-medium">
      <span>📦 {formato}</span>
    </div>
    
    <span class="block w-full text-center bg-purple-800 group-hover:bg-purple-900 text-white font-bold py-2.5 px-4 rounded-xl text-xs sm:text-sm transition-colors shadow-xs">
      Ver ficha completa
    </span>
  </div>
</a>