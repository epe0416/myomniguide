---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  slug: string;
  nombre: string;
  puntos?: number;
  categorias: string[];
  beneficioPrincipal: string;
  formato: string;
  imagen?: ImageMetadata;
}

const { slug, nombre, puntos, categorias, beneficioPrincipal, formato, imagen } = Astro.props;

const rawBaseUrl = import.meta.env.BASE_URL;
const baseUrl = rawBaseUrl.endsWith('/') ? rawBaseUrl : `${rawBaseUrl}/`;
---

<article class="group relative bg-white rounded-2xl border border-slate-200 shadow-xs hover:shadow-md hover:border-purple-300 transition-all flex flex-col justify-between overflow-hidden h-full">
  <!-- Área de Imagen -->
  <div class="bg-slate-50 p-6 flex justify-center items-center h-48 border-b border-slate-100 shrink-0">
    {imagen ? (
      <Image 
        src={imagen} 
        alt={`Imagen del producto ${nombre}`} 
        class="max-h-full w-auto object-contain drop-shadow-xs group-hover:scale-105 transition-transform duration-300"
        width={250}
        height={250}
      />
    ) : (
      <div class="text-slate-500 text-xs font-semibold">Sin imagen disponible</div>
    )}
  </div>

  <!-- Contenido de la Tarjeta -->
  <div class="p-6 flex flex-col flex-1 justify-between">
    <div>
      <div class="flex flex-wrap gap-1 mb-3 min-h-6">
        {categorias.map((cat) => (
          <span class="text-[10px] font-bold tracking-wider text-purple-900 bg-purple-100 px-2 py-0.5 rounded-md uppercase">
            {cat}
          </span>
        ))}
      </div>
      
      <!-- Enlace principal con Stretched Link (after:absolute after:inset-0) -->
      <h2 class="text-xl font-extrabold text-slate-950 mb-2">
        <a 
          href={`${baseUrl}productos/${slug}`} 
          aria-label={`Ver ficha completa de ${nombre}`}
          class="after:absolute after:inset-0 after:z-0 focus:outline-hidden"
        >
          {nombre}
        </a>
      </h2>
      
      <p class="text-slate-700 text-sm leading-relaxed mb-4 line-clamp-2" set:html={beneficioPrincipal} />
    </div>
    
    <div class="mt-auto">
      <div class="pt-4 border-t border-slate-100 flex items-center justify-between gap-2 mb-4 text-xs">
        <span class="text-slate-800 font-semibold bg-slate-100 px-2 py-1 rounded border border-slate-200/60">
          📦 {formato}
        </span>
        
        {typeof puntos === 'number' && (
          <span class="text-purple-950 font-extrabold bg-purple-50 px-2.5 py-1 rounded-md border border-purple-200/80 shrink-0">
            💎 {puntos} pts
          </span>
        )}
      </div>

      <!-- Botón visual (span) coordinado con group-hover -->
      <span class="block w-full text-center bg-purple-800 group-hover:bg-purple-900 text-white font-bold py-2.5 px-4 rounded-lg text-sm transition-colors shadow-xs">
        Ver ficha completa
      </span>
    </div>
  </div>
</article>