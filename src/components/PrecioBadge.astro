---
// src/components/PrecioBadge.astro
interface Props {
  precioNIO?: number;
  precioUSD?: number;
  clases?: string;
}

const { precioNIO, precioUSD, clases = "" } = Astro.props;

const nioVal = precioNIO ? `C$ ${precioNIO.toLocaleString('es-NI', { minimumFractionDigits: 2 })}` : 'Precio no disponible';
const usaVal = precioUSD ? `$${precioUSD.toFixed(2)} USD` : 'No disponible en USA';
---

{(precioNIO || precioUSD) && (
  <div class="relative group/tooltip inline-block">
    <span 
      class={`precio-badge inline-flex items-center gap-1 font-extrabold text-slate-900 dark:text-slate-100 bg-slate-100 dark:bg-purple-950/40 border border-slate-200/80 dark:border-purple-900/40 px-2.5 py-1 rounded-lg text-xs cursor-help ${clases}`}
      data-nio-val={nioVal}
      data-usa-val={usaVal}
      data-is-usa-available={precioUSD ? "true" : "false"}
      data-nio-tip="Este es el precio oficial en Nicaragua (NIO)"
      data-usa-tip={precioUSD ? "Este es el precio oficial en Estados Unidos (USA)" : "Producto no disponible para este mercado"}
    >
      <span class="precio-value">
        {nioVal}
      </span>
    </span>

    <!-- Burbuja Informativa (Tooltip) -->
    <div class="pointer-events-none absolute bottom-full left-1/2 -translate-x-1/2 mb-2 hidden group-hover/tooltip:flex flex-col items-center z-50 whitespace-nowrap transition-all duration-150">
      <span class="precio-tooltip-text bg-slate-950 text-white text-[10px] font-semibold px-2.5 py-1 rounded-lg shadow-xl border border-slate-800">
        Este es el precio oficial en Nicaragua (NIO)
      </span>
      <span class="w-2 h-2 -mt-1 rotate-45 bg-slate-950 border-r border-b border-slate-800"></span>
    </div>
  </div>
)}

<script is:inline>
  function actualizarPreciosVisibles() {
    let mercado = localStorage.getItem('moneda_pref') || 'NIO';
    if (mercado === 'USD') mercado = 'USA';
    
    const keyVal = `data-${mercado.toLowerCase()}-val`;
    const keyTip = `data-${mercado.toLowerCase()}-tip`;

    const badges = document.querySelectorAll('.precio-badge');
    
    badges.forEach((badge) => {
      const val = badge.getAttribute(keyVal);
      const tip = badge.getAttribute(keyTip);
      const isUsaAvailable = badge.getAttribute('data-is-usa-available') === 'true';

      const targetVal = badge.querySelector('.precio-value');
      const container = badge.closest('.group\\/tooltip');
      const targetTip = container ? container.querySelector('.precio-tooltip-text') : null;

      if (targetVal && val) {
        targetVal.textContent = val;
        
        // Si el usuario selecciona USA y el producto no cuenta con precio en ese mercado
        if (mercado === 'USA' && !isUsaAvailable) {
          badge.classList.add('text-amber-600', 'dark:text-amber-400', '!text-[10px]');
        } else {
          badge.classList.remove('text-amber-600', 'dark:text-amber-400', '!text-[10px]');
        }
      }
      if (targetTip && tip) {
        targetTip.textContent = tip;
      }
    });
  }

  document.addEventListener('DOMContentLoaded', actualizarPreciosVisibles);
  window.addEventListener('currency-changed', actualizarPreciosVisibles);
</script>