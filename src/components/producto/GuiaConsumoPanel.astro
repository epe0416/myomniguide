---
// src/components/producto/GuiaConsumoPanel.astro
import type { CollectionEntry } from 'astro:content';

interface Props {
  data: CollectionEntry<'productos'>['data'];
}

const { data } = Astro.props;
---

<div class="space-y-8">
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <div class="bg-purple-50/70 dark:bg-purple-950/20 border border-purple-200/80 dark:border-purple-900/50 p-6 rounded-2xl">
      <h2 class="font-bold text-purple-950 dark:text-purple-300 mb-4 flex items-center gap-2 text-base">
        <span class="text-purple-700 dark:text-purple-400">✨</span> Beneficios Clave
      </h2>
      <ul class="space-y-2.5 text-slate-800 dark:text-slate-200 text-sm">
        {data.beneficiosPrincipales.map((b) => (
          <li class="flex items-start gap-2">
            <span class="text-purple-700 dark:text-purple-400 font-bold">•</span>
            <span set:html={b} />
          </li>
        ))}
      </ul>
    </div>

    <div class="bg-white dark:bg-[#130f24] border border-slate-200 dark:border-purple-950/60 p-6 rounded-2xl shadow-xs">
      <h2 class="font-bold text-slate-950 dark:text-white mb-4 flex items-center gap-2 text-base">
        <span class="text-purple-700 dark:text-purple-400">⚡</span> Modo de Uso Recomendado
      </h2>
      <p class="text-slate-800 dark:text-slate-300 text-sm leading-relaxed mb-6">{data.modoUso}</p>

      <h3 class="font-bold text-slate-900 dark:text-slate-200 text-xs uppercase tracking-wider mb-2">Ideal para:</h3>
      <div class="flex flex-wrap gap-2">
        {data.paraQuienEs.map((p) => (
          <span class="text-xs bg-slate-100 dark:bg-purple-950/60 text-slate-800 dark:text-slate-300 px-3 py-1 rounded-md font-semibold border border-slate-200 dark:border-purple-900/50">
            {p}
          </span>
        ))}
      </div>
    </div>
  </div>

  <div class="bg-white dark:bg-[#130f24] p-8 rounded-2xl border border-slate-200 dark:border-purple-950/60 shadow-xs prose prose-purple dark:prose-invert max-w-none">
    <slot />
  </div>
</div>