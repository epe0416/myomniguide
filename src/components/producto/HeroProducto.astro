---
// src/components/producto/HeroProducto.astro
import { Image } from 'astro:assets';
import PrecioBadge from '../PrecioBadge.astro';
import type { CollectionEntry } from 'astro:content';
import type { ProductoComercial } from '../../data/inventario';

interface Props {
  producto: CollectionEntry<'productos'>;
  comercial: ProductoComercial | undefined;
  whatsappContactUrl: string;
  whatsappShareUrl: string;
}

const { producto, comercial, whatsappContactUrl, whatsappShareUrl } = Astro.props;
const { data } = producto;

const precioNIO = comercial?.nio?.precio;
const precioUSD = comercial?.usa?.precio;
const puntosNIO = comercial?.nio?.puntos;
const puntosUSD = comercial?.usa?.puntos;
const puntosIniciales = puntosNIO ?? puntosUSD ?? 0;

const tieneCatalogo = Boolean(data.imagenCatalogo);
---

<div class="bg-white dark:bg-[#130f24] p-6 md:p-8 rounded-3xl border border-slate-200/80 dark:border-purple-950/60 shadow-xs dark:shadow-[0_0_25px_rgba(147,51,235,0.15)] mb-8 grid grid-cols-1 md:grid-cols-12 gap-6 md:gap-8 items-center min-h-70 relative">
  {data.imagen && (
    <div 
      class={`md:col-span-4 flex justify-center items-center bg-slate-50 dark:bg-purple-950/25 p-6 rounded-2xl border border-slate-100 dark:border-purple-950/40 h-64 w-full aspect-square shrink-0 relative ${tieneCatalogo ? 'group cursor-pointer' : ''}`}
      {...(tieneCatalogo ? { id: 'open-catalog-modal' } : {})}
    >
      <Image 
        src={data.imagen} 
        alt={`Imagen del producto ${data.nombre}`} 
        class="max-h-52 w-auto object-contain drop-shadow-md transition-transform duration-300 group-hover:scale-[1.02]"
        width={400}
        height={400}
        loading="eager"
        fetchpriority="high"
      />

      {tieneCatalogo && (
        <div class="absolute inset-0 bg-purple-950/50 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center rounded-2xl text-white font-bold text-xs gap-1.5 backdrop-blur-[2px] shadow-lg">
          <span>🔍 Ver ficha oficial</span>
        </div>
      )}
    </div>
  )}
  
  <div class={data.imagen ? "md:col-span-8" : "md:col-span-12"}>
    <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
      <div class="flex flex-wrap gap-1.5">
        {data.categorias.map((cat) => (
          <span class="inline-block text-xs font-bold tracking-wider text-purple-900 dark:text-purple-300 bg-purple-100 dark:bg-purple-950/80 px-3 py-1 rounded-md uppercase">
            {cat}
          </span>
        ))}
      </div>

      {puntosIniciales > 0 && (
        <span 
          class="pts-badge inline-flex items-center gap-1 text-xs font-black text-purple-950 dark:text-purple-200 bg-purple-100/80 dark:bg-purple-950/80 px-3 py-1 rounded-xl border border-purple-200/60 dark:border-purple-900/50 shrink-0"
          data-nio-pts={puntosNIO ? `💎 ${puntosNIO} PTS` : ''}
          data-usa-pts={puntosUSD ? `💎 ${puntosUSD} PTS` : 'No disponible en USA'}
        >
          <span class="pts-value">💎 {puntosIniciales} PTS</span>
        </span>
      )}
    </div>

    <h1 class="text-3xl md:text-4xl font-extrabold text-slate-950 dark:text-white mb-2">{data.nombre}</h1>
    <p class="text-slate-700 dark:text-slate-300 text-lg mb-4" set:html={data.subtitulo} />

    <div class="flex flex-wrap items-center gap-3 mt-4">
      <div class="inline-flex items-center gap-2 text-xs font-semibold text-slate-700 dark:text-slate-300 bg-slate-100 dark:bg-purple-950/40 px-3 py-1.5 rounded-lg border border-slate-200/60 dark:border-purple-900/40">
        <span>📦 Formato:</span>
        <strong class="text-slate-900 dark:text-white">{data.formato}</strong>
      </div>

      {(precioNIO || precioUSD) && (
        <div class="inline-flex items-center gap-1.5 text-xs font-semibold text-slate-700 bg-emerald-50 dark:bg-emerald-950/30 border border-emerald-200/80 dark:border-emerald-900/50 px-3 py-1.5 rounded-lg">
          <span class="text-emerald-800 dark:text-emerald-400 font-bold">🏷️ Precio:</span>
          <PrecioBadge precioNIO={precioNIO} precioUSD={precioUSD} />
        </div>
      )}
    </div>

    <div class="flex flex-wrap items-center gap-3 mt-5 pt-4 border-t border-slate-200/60 dark:border-purple-950/60">
      <a 
        id="whatsapp-contact-btn"
        href={whatsappContactUrl} 
        target="_blank" 
        rel="noopener noreferrer"
        data-product-name={data.nombre}
        class="inline-flex items-center gap-2 bg-emerald-600 hover:bg-emerald-700 text-white px-4 py-2.5 rounded-xl text-xs font-bold transition-all shadow-xs cursor-pointer"
      >
        <span>💬 Consultar Asesoría</span>
      </a>

      <a 
        id="whatsapp-share-btn"
        href={whatsappShareUrl} 
        target="_blank" 
        rel="noopener noreferrer"
        data-product-name={data.nombre}
        class="inline-flex items-center gap-2 bg-purple-900 hover:bg-purple-800 text-white px-4 py-2.5 rounded-xl text-xs font-bold transition-all shadow-xs cursor-pointer"
      >
        <span>🔗 Compartir con mi Red</span>
      </a>
    </div>
  </div>
</div>