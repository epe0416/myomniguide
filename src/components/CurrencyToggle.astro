---
// src/components/CurrencyToggle.astro
---

<div id="currency-toggle" class="inline-flex items-center p-0.5 bg-slate-100 border border-slate-200 rounded-lg text-xs font-bold text-slate-600 shrink-0">
  <button 
    type="button" 
    data-currency="NIO"
    class="currency-btn px-2 py-1 sm:px-2.5 rounded-md transition-colors cursor-pointer bg-white text-purple-900 shadow-xs text-[11px] sm:text-xs flex items-center gap-1.5"
  >
    <!-- Bandera de Nicaragua (SVG) -->
    <svg class="w-4 h-3 rounded-xs shadow-2xs overflow-hidden shrink-0 border border-slate-300/60" viewBox="0 0 5 3" aria-hidden="true">
      <rect width="5" height="1" y="0" fill="#0067C6"/>
      <rect width="5" height="1" y="1" fill="#FFFFFF"/>
      <rect width="5" height="1" y="2" fill="#0067C6"/>
      <polygon points="2.5,1.25 2.15,1.75 2.85,1.75" fill="none" stroke="#004C91" stroke-width="0.08"/>
    </svg>
    <span>NIO</span>
  </button>

  <button 
    type="button" 
    data-currency="USA"
    class="currency-btn px-2 py-1 sm:px-2.5 rounded-md transition-colors cursor-pointer hover:text-slate-900 text-[11px] sm:text-xs flex items-center gap-1.5"
  >
    <!-- Bandera de EE. UU. (SVG) -->
    <svg class="w-4 h-3 rounded-xs shadow-2xs overflow-hidden shrink-0 border border-slate-300/60" viewBox="0 0 19 10" aria-hidden="true">
      <rect width="19" height="10" fill="#B22234"/>
      <path d="M0,1.53H19M0,3.07H19M0,4.61H19M0,6.15H19M0,7.69H19M0,9.23H19" stroke="#FFFFFF" stroke-width="0.77"/>
      <rect width="7.6" height="5.38" fill="#3C3B6E"/>
    </svg>
    <span>USA</span>
  </button>
</div>

<script is:inline>
  function initCurrencyToggle() {
    const container = document.getElementById('currency-toggle');
    if (!container) return;

    const buttons = container.querySelectorAll('.currency-btn');
    let savedCurrency = localStorage.getItem('moneda_pref') || 'NIO';
    
    if (savedCurrency === 'USD') {
      savedCurrency = 'USA';
      localStorage.setItem('moneda_pref', 'USA');
    }

    function setEstadoBotones(curr) {
      buttons.forEach((btn) => {
        if (btn.getAttribute('data-currency') === curr) {
          btn.classList.add('bg-white', 'text-purple-900', 'shadow-xs');
          btn.classList.remove('hover:text-slate-900');
        } else {
          btn.classList.remove('bg-white', 'text-purple-900', 'shadow-xs');
          btn.classList.add('hover:text-slate-900');
        }
      });
    }

    setEstadoBotones(savedCurrency);

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const selected = btn.getAttribute('data-currency');
        if (!selected) return;
        
        localStorage.setItem('moneda_pref', selected);
        setEstadoBotones(selected);
        
        window.dispatchEvent(new CustomEvent('currency-changed', { detail: { currency: selected } }));
      });
    });
  }

  document.addEventListener('DOMContentLoaded', initCurrencyToggle);
</script>