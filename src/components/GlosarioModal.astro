---
// src/components/GlosarioModal.astro
import { GLOSARIO } from '../data/glosario';
---

<!-- Modal Flotante de Glosario Centrado (Móvil y Desktop) -->
<div 
  id="glosario-modal" 
  class="fixed inset-0 bg-slate-900/40 backdrop-blur-xs z-50 flex items-center justify-center p-4 opacity-0 pointer-events-none transition-opacity duration-200"
>
  <div 
    id="glosario-card"
    class="bg-white dark:bg-[#130f24] w-full max-w-md rounded-3xl p-6 shadow-xl border border-slate-200/80 dark:border-purple-950/60 transition-all duration-200 dark:shadow-[0_0_25px_rgba(147,51,235,0.15)]"
  >
    <div class="flex items-start justify-between mb-3">
      <div class="flex items-center gap-2">
        <span class="text-lg">💡</span>
        <h3 id="glosario-titulo" class="font-extrabold text-slate-950 dark:text-white text-base"></h3>
      </div>
      <button 
        id="glosario-cerrar" 
        class="text-slate-500 dark:text-slate-400 hover:text-slate-950 dark:hover:text-white p-1 font-bold text-lg cursor-pointer transition-colors"
        aria-label="Cerrar explicación"
      >
        ✕
      </button>
    </div>
    
    <p id="glosario-descripcion" class="text-slate-700 dark:text-slate-300 text-sm leading-relaxed"></p>
    
    <div class="mt-5 pt-3 border-t border-slate-100 dark:border-purple-950/40 text-right">
      <span class="text-[10px] uppercase font-bold tracking-wider text-purple-900 dark:text-purple-300 bg-purple-100 dark:bg-purple-950/80 px-2.5 py-1 rounded-md">
        Término Técnico Explicado
      </span>
    </div>
  </div>
</div>

<script is:inline define:vars={{ GLOSARIO }}>
  document.addEventListener('DOMContentLoaded', () => {
    const modal = document.getElementById('glosario-modal');
    const tituloEl = document.getElementById('glosario-titulo');
    const descEl = document.getElementById('glosario-descripcion');
    const btnCerrar = document.getElementById('glosario-cerrar');

    function abrirModal(key) {
      const datos = GLOSARIO[key];
      if (!datos || !modal || !tituloEl || !descEl) return;

      tituloEl.textContent = datos.titulo;
      descEl.textContent = datos.descripcion;

      modal.classList.remove('opacity-0', 'pointer-events-none');
      modal.classList.add('opacity-100');
    }

    function cerrarModal() {
      if (!modal) return;
      modal.classList.add('opacity-0', 'pointer-events-none');
      modal.classList.remove('opacity-100');
    }

    document.addEventListener('click', (e) => {
      const target = e.target.closest('.glosario-term');
      if (target) {
        e.preventDefault();
        const key = target.getAttribute('data-term');
        if (key) abrirModal(key);
      }
    });

    btnCerrar?.addEventListener('click', cerrarModal);

    modal?.addEventListener('click', (e) => {
      if (e.target === modal) cerrarModal();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') cerrarModal();
    });
  });
</script>