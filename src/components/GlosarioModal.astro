---
import { GLOSARIO } from '../data/glosario';
---

<!-- Modal Flotante / Popover de Glosario -->
<div 
  id="glosario-modal" 
  class="fixed inset-0 bg-slate-900/40 backdrop-blur-xs z-50 flex items-end sm:items-center justify-center p-4 opacity-0 pointer-events-none transition-opacity duration-200"
>
  <div 
    id="glosario-card"
    class="bg-white w-full max-w-md rounded-2xl p-6 shadow-xl border border-slate-200 transform translate-y-4 sm:translate-y-0 transition-transform duration-200"
  >
    <div class="flex items-start justify-between mb-2">
      <div class="flex items-center gap-2">
        <span class="text-lg">💡</span>
        <h3 id="glosario-titulo" class="font-extrabold text-slate-950 text-base"></h3>
      </div>
      <button 
        id="glosario-cerrar" 
        class="text-slate-700 hover:text-slate-950 p-1 font-bold text-lg cursor-pointer"
        aria-label="Cerrar explicación"
      >
        ✕
      </button>
    </div>
    
    <p id="glosario-descripcion" class="text-slate-700 text-sm leading-relaxed"></p>
    
    <div class="mt-4 pt-3 border-t border-slate-100 text-right">
      <span class="text-[10px] uppercase font-bold tracking-wider text-purple-800 bg-purple-50 px-2 py-1 rounded">
        Término Técnico Explicado
      </span>
    </div>
  </div>
</div>

<script is:inline define:vars={{ GLOSARIO }}>
  document.addEventListener('DOMContentLoaded', () => {
    const modal = document.getElementById('glosario-modal');
    const card = document.getElementById('glosario-card');
    const tituloEl = document.getElementById('glosario-titulo');
    const descEl = document.getElementById('glosario-descripcion');
    const btnCerrar = document.getElementById('glosario-cerrar');

    function abrirModal(key) {
      const datos = GLOSARIO[key];
      if (!datos || !modal || !tituloEl || !descEl) return;

      tituloEl.textContent = datos.titulo;
      descEl.textContent = datos.descripcion;

      modal.classList.remove('opacity-0', 'pointer-events-none');
      modal.classList.add('opacity-100');
    }

    function cerrarModal() {
      if (!modal) return;
      modal.classList.add('opacity-0', 'pointer-events-none');
      modal.classList.remove('opacity-100');
    }

    // Event Delegated Listener para cualquier palabra con clase .glosario-term
    document.addEventListener('click', (e) => {
      const target = e.target.closest('.glosario-term');
      if (target) {
        e.preventDefault();
        const key = target.getAttribute('data-term');
        if (key) abrirModal(key);
      }
    });

    btnCerrar?.addEventListener('click', cerrarModal);

    modal?.addEventListener('click', (e) => {
      if (e.target === modal) cerrarModal();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') cerrarModal();
    });
  });
</script>