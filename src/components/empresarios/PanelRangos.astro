        pp: "1,500 PP",
        pg: "4,000 PG",
        pld: "-",
        la: "4 LA",
        gainN1: "10% (+10% BIR)",
        gainN2: "8% (+5% BIR)",
        gainExtra: "2% en 3er Nivel",
        strategy: "Amplía tu estructura a 4 líneas activas y ayuda a tus primeros 2 socios a subir de rango."
      },
      {
        id: "p-elite",
        nombre: "Plata Elite",
        titles: "2 Bronce Elite en 1er Nivel",
        pp: "2,000 PP",
        pg: "7,000 PG",
        pld: "-",
        la: "4 LA",
        gainN1: "10% (+10% BIR)",
        gainN2: "8% (+5% BIR)",
        gainExtra: "4% en 3er Nivel",
        strategy: "Consolida volúmenes de 7,000 PG impulsando a tu equipo a calificar a la escala Bronce Elite."
      },
      {
        id: "p-supreme",
        nombre: "Plata Supreme",
        titles: "4 Bronce Supreme en 1er Nivel",
        pp: "2,500 PP",
        pg: "10,000 PG / PLD",
        pld: "10,000 PLD",
        la: "4 LA",
        gainN1: "10% (+10% BIR)",
        gainN2: "8% (+5% BIR)",
        gainExtra: "6% 3er Nivel + 2% 1ª Gen",
        strategy: "¡La llave de la independencia financiera! Formas líderes independientes y abres cobros de Generaciones."
      }
    ],
    oro: [
      {
        id: "o-premier",
        nombre: "Oro Premier",
