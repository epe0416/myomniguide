  let currentCategory = 'bronce';
  let currentSubIndex = 0;

  function initInspectorRangos() {
    const categoryButtons = document.querySelectorAll('.category-btn');
    const subContainer = document.getElementById('sub-buttons-container');
    const categoryTitleSpan = document.getElementById('category-title-span');

    if (!categoryButtons.length || !subContainer) return;

    function renderSubButtons(catKey) {
      const list = RANGOS_DATA[catKey] || RANGOS_DATA.bronce;
      subContainer.innerHTML = '';

      list.forEach((item, index) => {
        const btn = document.createElement('button');
        const isActive = index === currentSubIndex;

        btn.className = `px-4 py-2 rounded-xl text-xs font-black transition-all cursor-pointer border ${
          isActive 
            ? 'bg-purple-600 text-white border-purple-500 shadow-md scale-105' 
            : 'bg-white dark:bg-[#0c0816] text-slate-700 dark:text-slate-300 border-slate-200 dark:border-purple-900/60 hover:border-purple-400'
        }`;
        
        btn.textContent = item.nombre;
        btn.addEventListener('click', () => {
          currentSubIndex = index;
          renderSubButtons(catKey);
          updateCard(catKey, index);
        });

        subContainer.appendChild(btn);
      });
    }

    function updateCard(catKey, subIdx) {
      const item = RANGOS_DATA[catKey][subIdx];
      if (!item) return;

      const cardBadge = document.getElementById('card-badge');
      const cardTitle = document.getElementById('card-title');
      const cardTitles = document.getElementById('card-titles');
      const reqPp = document.getElementById('req-pp');
      const reqPg = document.getElementById('req-pg');
      const reqPld = document.getElementById('req-pld');
      const reqLa = document.getElementById('req-la');
      const gainN1 = document.getElementById('gain-n1');
      const gainN2N3 = document.getElementById('gain-n2n3');
      const gainExtra = document.getElementById('gain-extra');
      const rankStrategy = document.getElementById('rank-strategy');

      if (cardBadge) cardBadge.textContent = item.nombre;
      if (cardTitle) cardTitle.textContent = item.nombre;
      if (cardTitles) cardTitles.textContent = item.titles;
      if (reqPp) reqPp.textContent = item.pp;
      if (reqPg) reqPg.textContent = item.pg;
      if (reqPld) reqPld.textContent = item.pld;
      if (reqLa) reqLa.textContent = item.la;
      if (gainN1) gainN1.textContent = item.gainN1;
      if (gainN2N3) gainN2N3.textContent = item.gainN2;
      if (gainExtra) gainExtra.textContent = item.gainExtra;
      if (rankStrategy) rankStrategy.textContent = item.strategy;
    }

    categoryButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        categoryButtons.forEach((b) => {
          b.classList.remove('active-cat', 'bg-linear-to-br', 'from-purple-900', 'via-slate-900', 'to-purple-950', 'text-white', 'border-purple-500', 'shadow-lg');
          b.classList.add('bg-slate-50', 'dark:bg-purple-950/30', 'text-slate-700', 'dark:text-slate-300', 'border-slate-200', 'dark:border-purple-900/50');
        });

        btn.classList.remove('bg-slate-50', 'dark:bg-purple-950/30', 'text-slate-700', 'dark:text-slate-300', 'border-slate-200', 'dark:border-purple-900/50');
        btn.classList.add('active-cat', 'bg-linear-to-br', 'from-purple-900', 'via-slate-900', 'to-purple-950', 'text-white', 'border-purple-500', 'shadow-lg');

        const cat = btn.getAttribute('data-category');
        currentCategory = cat;
        currentSubIndex = 0;

        if (categoryTitleSpan) {
          categoryTitleSpan.textContent = cat.charAt(0).toUpperCase() + cat.slice(1);
        }

        renderSubButtons(cat);
        updateCard(cat, 0);
      });
    });

    renderSubButtons('bronce');
    updateCard('bronce', 0);
  }

  // Observer para Animaciones de Scroll
  function initRangosObserver() {
    const blocks = document.querySelectorAll('#panel-rangos .fade-in-block');
    if (blocks.length === 0) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.remove('opacity-0', 'translate-y-10');
            entry.target.classList.add('opacity-100', 'translate-y-0');
            observer.unobserve(entry.target);
          }
        });
      },
      {
        root: null,
        rootMargin: '0px 0px -60px 0px',
        threshold: 0.1,
      }
    );

    blocks.forEach((block) => observer.observe(block));
  }

  document.addEventListener('DOMContentLoaded', () => {
    initInspectorRangos();
    initRangosObserver();
  });
</script>