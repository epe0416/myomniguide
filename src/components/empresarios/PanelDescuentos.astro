        <div class="space-y-2 text-xs">
          <div class="flex justify-between">
            <span class="text-purple-300">Unidades Totales (2 Meses):</span>
            <span id="m40-unidades" class="font-black text-white text-sm">75 Cajas</span>
          </div>
          <div class="flex justify-between">
            <span class="text-purple-300">Puntos Computados:</span>
            <span id="m40-puntos" class="font-bold text-emerald-400">4,050 PTS</span>
          </div>
          <div class="flex justify-between pt-1 border-t border-purple-800/40">
            <span class="text-purple-200 font-semibold">Venta Total Sugerida:</span>
            <span id="m40-venta" class="font-bold text-white">C$ 88,875.00</span>
          </div>
          <div class="flex justify-between">
            <span class="text-purple-200 font-semibold">Inversión Estimada (Comprando al 35%):</span>
            <span id="m40-costo" class="font-bold text-white">C$ 60,851.25</span>
          </div>
        </div>

        <div class="bg-amber-400/20 p-3.5 rounded-xl border border-amber-400/40 flex justify-between items-center">
          <span class="text-xs font-extrabold text-amber-300">Ganancia Neta por Menudeo:</span>
          <span id="m40-ganancia" class="text-base font-black text-amber-400">C$ 28,023.75</span>
        </div>
      </div>
    </div>
  </div>

  <!-- 6. REMATE DEL PANEL: PAQUETE DE INICIO RÁPIDO MULTIPRODUCTO (~C$ 16,500) (Bloque 6) -->
  <div class="fade-in-block opacity-0 translate-y-10 transition-all duration-700 ease-out relative bg-linear-to-br from-slate-950 via-purple-950 to-slate-900 border-2 border-purple-500/40 rounded-3xl p-6 sm:p-10 text-white shadow-2xl overflow-hidden space-y-8">
    <!-- Glows Decorativos de Fondo -->
    <div class="absolute top-0 right-0 w-80 h-80 bg-purple-600/15 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute bottom-0 left-0 w-80 h-80 bg-emerald-600/10 rounded-full blur-3xl pointer-events-none"></div>

    <!-- Encabezado del Remate -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-purple-800/60 pb-6 relative z-10">
      <div class="space-y-2">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 bg-linear-to-r from-amber-400 to-amber-500 text-slate-950 font-black text-[11px] uppercase tracking-wider rounded-lg shadow-md">
          <span>⚡ ESTRATEGIA RECOMENDADA</span>
        </div>
        <h3 class="text-2xl sm:text-4xl font-black text-white tracking-tight">
          Combo de Inicio Rápido: <span class="text-transparent bg-clip-text bg-linear-to-r from-purple-300 via-amber-300 to-emerald-300">1,000 Puntos Directos</span>
        </h3>
        <p class="text-xs sm:text-sm text-purple-200/90 max-w-2xl leading-relaxed">
          La mejor estrategia para el nuevo distribuidor. Invierte en un surtido equilibrado con los 4 pilares de mayor rotación comercial en Nicaragua y salta automáticamente al <strong>30% de descuento</strong> desde tu primer pedido.
        </p>
      </div>

      <div class="bg-purple-900/60 border border-purple-700/60 p-4 rounded-2xl text-center shrink-0">
        <span class="text-[10px] font-extrabold uppercase tracking-wider text-purple-300 block">Descuento Activado</span>
        <span class="text-3xl font-black text-amber-400">30% DIRECTO</span>
        <span class="text-[10px] text-emerald-400 font-bold block mt-0.5">1,002 PTS Acumulados</span>
      </div>
    </div>

    <!-- Tabla / Grid de Productos del Combo -->
    <div class="space-y-3 relative z-10">
      <span class="block text-xs font-extrabold uppercase tracking-wider text-purple-300">
        📦 Contenido Sugerido del Paquete de Inicio (~C$ 16,500 NIO):
      </span>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
        {comboInicioRapido.items.map((item) => (
          <div class="bg-slate-900/80 border border-purple-900/60 p-4 rounded-xl flex items-center justify-between gap-3 hover:border-purple-500/60 transition-all">
            <div class="space-y-0.5">
              <span class="text-xs font-black text-white block">{item.cant}x {item.prod}</span>
              <span class="text-[10px] text-purple-300/80 block">{item.objetivo}</span>
            </div>
            <span class="text-xs font-bold text-amber-400 bg-purple-950 px-2 py-1 rounded-md shrink-0">
              +{item.pts} PTS
            </span>
          </div>
        ))}
      </div>
    </div>

    <!-- Resumen Financiero: Inversión vs Retorno -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-2 relative z-10">
      <!-- Inversión al 30% -->
      <div class="bg-slate-900/90 border border-purple-800/60 p-5 rounded-2xl space-y-1">
        <span class="text-[11px] font-extrabold uppercase tracking-wider text-purple-300">Inversión Aproximada (30%)</span>
        <div class="text-2xl font-black text-white">
          C$ {comboInicioRapido.inversion.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}
        </div>
        <span class="text-[10px] text-purple-400 block">Pago de contado a Omnilife</span>
      </div>

      <!-- Venta Total Sugerida -->
      <div class="bg-slate-900/90 border border-purple-800/60 p-5 rounded-2xl space-y-1">
        <span class="text-[11px] font-extrabold uppercase tracking-wider text-purple-300">Recuperación por Venta</span>
        <div class="text-2xl font-black text-white">
          C$ {comboInicioRapido.recuperacionVenta.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}
        </div>
        <span class="text-[10px] text-purple-400 block">Ingreso bruto al menudear</span>
      </div>

      <!-- Ganancia Neta -->
      <div class="bg-linear-to-br from-emerald-950/80 to-purple-950/80 border border-emerald-500/50 p-5 rounded-2xl space-y-1">
        <span class="text-[11px] font-extrabold uppercase tracking-wider text-emerald-300">Ganancia Neta Limpia</span>
        <div class="text-2xl font-black text-emerald-400">
          C$ {comboInicioRapido.gananciaLiquida.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}
        </div>
        <span class="text-[10px] text-emerald-300/80 block">Rentabilidad inmediata (+37%)</span>
      </div>
    </div>

    <!-- Mensaje Motivacional Cierre -->
    <div class="bg-purple-950/70 border border-purple-800/60 p-4 rounded-2xl flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 text-xs text-purple-200 relative z-10">
      <div class="flex items-center gap-3">
        <span class="text-2xl">💡</span>
        <p class="leading-relaxed">
          <strong>¿Por qué arrancar con este combo?</strong> Colocas tu capital a trabajar de inmediato, tienes stock variado en mano para entregas rápidas y estás a la mitad del camino para congelar tu <strong>35% definitivo</strong>.
        </p>
      </div>
    </div>

  </div>

</div>

<script is:inline>
  // Objeto con Datos Oficiales de Lista de Precios
  const PRODUCTOS_DATA = {
    magnus: { pts: 54, sugerido: 1185, c30: 864.73, g30: 320.27, c35: 811.35, g35: 373.65, c40: 757.97, g40: 427.03 },
    omniplus: { pts: 87, sugerido: 1740, c30: 1269.73, g30: 470.27, c35: 1191.35, g35: 548.65, c40: 1112.97, g40: 627.03 },
    cafezzino: { pts: 57, sugerido: 1640, c30: 1196.75, g30: 443.25, c35: 1122.88, g35: 517.12, c40: 1049.01, g40: 590.99 },
    powermaker: { pts: 110, sugerido: 2230, c30: 1627.29, g30: 602.71, c35: 1526.84, g35: 703.16, c40: 1426.39, g40: 803.61 },
    teatino: { pts: 63, sugerido: 1500, c30: 1094.50, g30: 405.40, c35: 1027.03, g35: 472.97, c40: 959.46, g40: 540.54 }
  };

  function initSimuladorDescuentos() {
    // 1. Calculadora Financiera por Producto Bandera
    const prodSelect = document.getElementById('prod-select');
    
    function actualizarCalculadoraProducto() {
      const prodKey = prodSelect ? prodSelect.value : 'magnus';
      const data = PRODUCTOS_DATA[prodKey] || PRODUCTOS_DATA.magnus;

      const formatNio = (num) => `C$ ${num.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;

      // Meta 1000 PTS (Comprando al 30%)
      const u30 = Math.ceil(1000 / data.pts);
      const pts30 = u30 * data.pts;
      const venta30 = u30 * data.sugerido;
      const costo30 = u30 * data.c30;
      const ganancia30 = u30 * data.g30;

      const elU30 = document.getElementById('m30-unidades');
      const elPts30 = document.getElementById('m30-puntos');
      const elVenta30 = document.getElementById('m30-venta');
      const elCosto30 = document.getElementById('m30-costo');
      const elGanancia30 = document.getElementById('m30-ganancia');

      if (elU30) elU30.textContent = `${u30} Cajas`;
      if (elPts30) elPts30.textContent = `${pts30.toLocaleString()} PTS`;
      if (elVenta30) elVenta30.textContent = formatNio(venta30);
      if (elCosto30) elCosto30.textContent = formatNio(costo30);
      if (elGanancia30) elGanancia30.textContent = formatNio(ganancia30);

      // Meta 2000 PTS (Comprando al 35%)
      const u35 = Math.ceil(2000 / data.pts);
      const pts35 = u35 * data.pts;
      const venta35 = u35 * data.sugerido;
      const costo35 = u35 * data.c35;
      const ganancia35 = u35 * data.g35;

      const elU35 = document.getElementById('m35-unidades');
      const elPts35 = document.getElementById('m35-puntos');
      const elVenta35 = document.getElementById('m35-venta');
      const elCosto35 = document.getElementById('m35-costo');
      const elGanancia35 = document.getElementById('m35-ganancia');

      if (elU35) elU35.textContent = `${u35} Cajas`;
      if (elPts35) elPts35.textContent = `${pts35.toLocaleString()} PTS`;
      if (elVenta35) elVenta35.textContent = formatNio(venta35);
      if (elCosto35) elCosto35.textContent = formatNio(costo35);
      if (elGanancia35) elGanancia35.textContent = formatNio(ganancia35);

      // Meta 4000 PTS (Acumulados al 35% o 40%)
      const u40 = Math.ceil(4000 / data.pts);
      const pts40 = u40 * data.pts;
      const venta40 = u40 * data.sugerido;
      const costo40 = u40 * data.c35;
      const ganancia40 = u40 * data.g35;

      const elU40 = document.getElementById('m40-unidades');
      const elPts40 = document.getElementById('m40-puntos');
      const elVenta40 = document.getElementById('m40-venta');
      const elCosto40 = document.getElementById('m40-costo');
      const elGanancia40 = document.getElementById('m40-ganancia');

      if (elU40) elU40.textContent = `${u40} Cajas`;
      if (elPts40) elPts40.textContent = `${pts40.toLocaleString()} PTS`;
      if (elVenta40) elVenta40.textContent = formatNio(venta40);
      if (elCosto40) elCosto40.textContent = formatNio(costo40);
      if (elGanancia40) elGanancia40.textContent = formatNio(ganancia40);
    }

    prodSelect?.addEventListener('change', actualizarCalculadoraProducto);
    actualizarCalculadoraProducto();

    // 2. Simulador de Sliders por Periodos Mensuales
    const m1Slider = document.getElementById('m1-slider');
    const m2Slider = document.getElementById('m2-slider');
    const m1Val = document.getElementById('m1-val');
    const m2Val = document.getElementById('m2-val');

    const descPorcentajeRes = document.getElementById('desc-porcentaje-res');
    const puntosTotalesRes = document.getElementById('puntos-totales-res');
    const puntos40Validos = document.getElementById('puntos-40-validos');
    const estadoPermanencia = document.getElementById('estado-permanencia');
    const barraProgreso = document.getElementById('barra-progreso');
    const progresoPorcentajeTexto = document.getElementById('progreso-porcentaje-texto');
    const descMensajeRes = document.getElementById('desc-mensaje-res');

    if (!m1Slider || !m2Slider) return;

    function calcularSliders() {
      const p1 = parseInt(m1Slider.value || '0');
      const p2 = parseInt(m2Slider.value || '0');

      if (m1Val) m1Val.textContent = p1.toLocaleString();
      if (m2Val) m2Val.textContent = p2.toLocaleString();

      const totalAcumulado = p1 + p2;
      
      const v1 = Math.floor(p1 / 1000) * 1000;
      const v2 = Math.floor(p2 / 1000) * 1000;
      const totalValido40 = v1 + v2;

      let descuento = '25%';
      let mensaje = 'Inicias directamente al 25% con tu afiliación. Acumula 1,000 puntos para subir al 30%.';
      let permanencia = 'Descuento Base de Afiliación';

      if (totalAcumulado >= 2000) {
        descuento = '35%';
        mensaje = '¡Excelente! Has alcanzado el 35%. Tu porcentaje queda protegido y congelado de por vida.';
        permanencia = '¡Nivel Fijo Protegido!';
      } else if (totalAcumulado >= 1000) {
        descuento = '30%';
        mensaje = '¡Buen trabajo! Estás al 30%. Sigue acumulando para subir al 35% protegido en los 2,000 PTS.';
      }

      const califica40 = totalValido40 >= 4000;

      if (califica40) {
        descuento = '40%';
        mensaje = '¡Felicidades! Has cumplido la regla de múltiplos de 1,000 PTS en 2 meses y alcanzado el 40% Mayor Descuento.';
        permanencia = '¡Descuento Mayorista!';
      } else if (totalAcumulado >= 4000 && totalValido40 < 4000) {
        mensaje = `Tienes ${totalAcumulado.toLocaleString()} PTS acumulados, pero para la regla del 40% solo computan bloques de 1,000 PTS por mes (tienes ${totalValido40.toLocaleString()} PTS válidos al 40%).`;
      }

      if (descPorcentajeRes) descPorcentajeRes.textContent = descuento;
      if (puntosTotalesRes) puntosTotalesRes.textContent = `${totalAcumulado.toLocaleString()} PTS`;
      if (puntos40Validos) puntos40Validos.textContent = `${totalValido40.toLocaleString()} PTS`;
      if (estadoPermanencia) estadoPermanencia.textContent = permanencia;
      if (descMensajeRes) descMensajeRes.textContent = mensaje;

      const porcentajeProgreso = Math.min(100, Math.round((totalValido40 / 4000) * 100));
      if (barraProgreso) barraProgreso.style.width = `${porcentajeProgreso}%`;
      if (progresoPorcentajeTexto) progresoPorcentajeTexto.textContent = `${porcentajeProgreso}%`;
    }

    m1Slider.addEventListener('input', calcularSliders);
    m2Slider.addEventListener('input', calcularSliders);

    calcularSliders();
  }

  // 3. Observer para Animación al Hacer Scroll
  function initDescuentosObserver() {
    const blocks = document.querySelectorAll('#panel-calculadora .fade-in-block');
    if (blocks.length === 0) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.remove('opacity-0', 'translate-y-10');
            entry.target.classList.add('opacity-100', 'translate-y-0');
            observer.unobserve(entry.target);
          }
        });
      },
      {
        root: null,
        rootMargin: '0px 0px -60px 0px',
        threshold: 0.1,
      }
    );

    blocks.forEach((block) => observer.observe(block));
  }

  document.addEventListener('DOMContentLoaded', () => {
    initSimuladorDescuentos();
    initDescuentosObserver();
  });
</script>