---
// src/components/empresarios/PanelDescuentos.astro

const nivelesDescuento = [
  { porc: "25%", pts: "0 - 999 PTS", desc: "Descuento base automático al afiliarte. Válido desde tu primer pedido sin mínimo de compra.", permanente: true, badge: "Base Afiliación" },
  { porc: "30%", pts: "1,000 - 1,999 PTS", desc: "Primer incremento de margen comercial al acumular tus pedidos.", permanente: false, badge: "Intermedio" },
  { porc: "35%", pts: "2,000+ PTS", desc: "¡Nivel Fijo Protegido! Una vez alcanzado este porcentaje, jamás vuelves a bajar.", permanente: true, badge: "Fijo / Protegido" },
  { porc: "40%", pts: "4,000 PTS (en 1 o 2 meses)", desc: "Máximo descuento mayorista. Mantén tu nivel completando 1,500 PP al año.", permanente: true, badge: "Mayor Descuento" },
];

const combinaciones40 = [
  { m1: "4,000 PP", m2: "0 PP", titulo: "Calificación Directa", desc: "Completa 4,000 Puntos Personales en un solo periodo mensual." },
  { m1: "1,000 PP", m2: "3,000 PP", titulo: "Estrategia Progresiva A", desc: "Consolida 1,000 PP el primer mes y acelera a 3,000 PP en el segundo." },
  { m1: "2,000 PP", m2: "2,000 PP", titulo: "Estrategia Equilibrada", desc: "Ritmo constante de 2,000 PP en dos periodos mensuales consecutivos." },
  { m1: "3,000 PP", m2: "1,000 PP", titulo: "Estrategia Progresiva B", desc: "Asegura el mayor volumen en el primer mes y cierra con 1,000 PP." },
];

// Datos Oficiales de Productos Top para la Calculadora Financiera
const productosTop = [
  { id: 'magnus', nombre: 'Magnus Supreme (Caja 30 Sach)', pts: 54, sugerido: 1185, c30: 864.73, c35: 811.35, c40: 757.97, g30: 320.27, g35: 373.65, g40: 427.03 },
  { id: 'omniplus', nombre: 'Omniplus Frutas (30 Sach)', pts: 87, sugerido: 1740, c30: 1269.73, c35: 1191.35, c40: 1112.97, g30: 470.27, g35: 548.65, g40: 627.03 },
  { id: 'cafezzino', nombre: 'Cafezzino Evolución (30 Sach)', pts: 57, sugerido: 1640, c30: 1196.75, c35: 1122.88, c40: 1049.01, g30: 443.25, g35: 517.12, g40: 590.99 },
  { id: 'powermaker', nombre: 'Power Maker (Caja 30 Sach)', pts: 110, sugerido: 2230, c30: 1627.29, c35: 1526.84, c40: 1426.39, g30: 602.71, g35: 703.16, g40: 803.61 },
  { id: 'teatino', nombre: 'Teatino Limón (Caja 30 Sach)', pts: 63, sugerido: 1500, c30: 1094.50, c35: 1027.03, c40: 959.46, g30: 405.40, g35: 472.97, g40: 540.54 }
];

// Desglose del Combo Multiproducto de Inicio Rápido (~C$ 16,500)
const comboInicioRapido = {
  items: [
    { cant: 5, prod: "Magnus Supreme", pts: 270, objetivo: "Energía y Rendimiento Diario" },
    { cant: 3, prod: "Omniplus Frutas", pts: 261, objetivo: "Nutrición Base e Inmunidad" },
    { cant: 5, prod: "Cafezzino Evolución", pts: 285, objetivo: "Control de Peso y Metabolismo" },
    { cant: 4, prod: "Flu-Y (60 Cáp)", pts: 176, objetivo: "Equilibrio, Estrés y Sueño" },
    { cant: 5, prod: "Agua Blu 600ml", pts: 10, objetivo: "Hidratación e Impacto Visual" }
  ],
  totalPts: 1002,
  inversion: 16670.67,
  recuperacionVenta: 22905.00,
  gananciaLiquida: 6234.33
};
---

<div id="panel-calculadora" class="emp-panel hidden space-y-12 max-w-6xl mx-auto py-4">
  
  <!-- Encabezado del Módulo (Bloque 0) -->
  <div class="fade-in-block opacity-0 translate-y-10 transition-all duration-700 ease-out bg-white dark:bg-[#130f24] border border-slate-200/90 dark:border-purple-950/80 p-8 sm:p-10 rounded-3xl text-center space-y-3 relative overflow-hidden shadow-xs dark:shadow-lg">
    <div class="absolute -right-10 -bottom-10 w-40 h-40 bg-purple-500/10 dark:bg-purple-600/10 rounded-full blur-3xl pointer-events-none"></div>
    <span class="inline-block px-3.5 py-1 bg-purple-100 dark:bg-purple-500/20 text-purple-900 dark:text-purple-300 border border-purple-200 dark:border-purple-500/30 rounded-full text-xs font-extrabold uppercase tracking-wider">
      Plan de Compensación Oficial
    </span>
    <h2 class="text-2xl sm:text-4xl font-black text-slate-950 dark:text-white tracking-tight">
      Escala de Descuentos y Proyección de Inversión
    </h2>
    <p class="text-xs sm:text-sm text-slate-600 dark:text-purple-200/90 max-w-2xl mx-auto leading-relaxed font-medium">
      Proyecta tus ganancias reales de menudeo en Córdobas (C$), conoce cuántas unidades necesitas para escalar de nivel y planifica tu salto al 40% mayorista.
    </p>
  </div>

  <!-- 1. Infografía Visual de Niveles de Descuento (Bloque 1) -->
  <div class="fade-in-block opacity-0 translate-y-10 transition-all duration-700 ease-out space-y-4">
    <div class="flex items-center justify-between">
      <h3 class="text-lg sm:text-xl font-black text-slate-950 dark:text-white flex items-center gap-2">
        <span>📈</span> Escala Fija de Descuentos
      </h3>
      <span class="text-xs font-semibold text-purple-700 dark:text-purple-400">Puntos Acumulables</span>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {nivelesDescuento.map((nivel) => (
        <div class={`bg-white dark:bg-[#130f24] border ${nivel.porc === '40%' ? 'border-amber-400 dark:border-amber-500/60 ring-2 ring-amber-400/20' : 'border-slate-200/90 dark:border-purple-950/80'} p-6 rounded-2xl shadow-xs flex flex-col justify-between relative overflow-hidden group hover:border-purple-400 transition-all`}>
          {nivel.permanente && (
            <span class="absolute top-0 right-0 bg-amber-500 text-slate-950 text-[9px] font-black uppercase px-2 py-0.5 rounded-bl-lg">
              {nivel.porc === '25%' ? 'Base' : 'Protegido'}
            </span>
          )}
          <div class="space-y-2">
            <span class="text-[10px] font-extrabold uppercase tracking-wider text-purple-700 dark:text-purple-300 bg-purple-100 dark:bg-purple-950/80 px-2.5 py-1 rounded-md inline-block">
              {nivel.badge}
            </span>
            <div class="text-4xl font-black text-slate-950 dark:text-white group-hover:text-purple-600 dark:group-hover:text-purple-400 transition-colors">
              {nivel.porc}
            </div>
            <div class="text-xs font-extrabold text-purple-900 dark:text-purple-300">
              {nivel.pts}
            </div>
            <p class="text-[11px] text-slate-600 dark:text-slate-300 leading-relaxed pt-1">
              {nivel.desc}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- 2. Simulador Interactivo Avanzado de Sliders de 2 Meses (Bloque 2) -->
  <div class="fade-in-block opacity-0 translate-y-10 transition-all duration-700 ease-out bg-white dark:bg-[#130f24] border border-slate-200/90 dark:border-purple-950/80 p-6 sm:p-8 rounded-3xl shadow-lg space-y-8">
    <div class="border-b border-slate-100 dark:border-purple-950/60 pb-4">
      <h3 class="text-xl font-black text-slate-950 dark:text-white flex items-center gap-2">
        <span>🧮</span> Simulador de Calificación al 40% (En 1 o 2 Meses)
      </h3>
      <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 mt-1">
        Ajusta tus puntos estimados para 2 periodos mensuales consecutivos y diagnostica tu nivel de descuento según la regla de múltiplos de 1,000.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
      <!-- Sliders de Control (7 Cols) -->
      <div class="lg:col-span-7 space-y-6">
        <!-- Control Mes 1 -->
        <div class="space-y-2 bg-slate-50 dark:bg-purple-950/20 p-4 rounded-2xl border border-slate-100 dark:border-purple-950/50">
          <div class="flex justify-between items-center text-xs font-extrabold uppercase tracking-wider">
            <span class="text-slate-700 dark:text-slate-300">📅 Periodo Mensual 1:</span>
            <span class="text-purple-600 dark:text-purple-400 text-sm font-black"><span id="m1-val">1000</span> PTS</span>
          </div>
          <input 
            type="range" 
            id="m1-slider" 
            min="0" 
            max="4000" 
            step="100" 
            value="1000" 
            class="w-full accent-purple-600 cursor-pointer"
          />
          <div class="flex justify-between text-[10px] text-slate-400 font-bold">
            <span>0 PTS</span>
            <span>1,000 PTS</span>
            <span>2,000 PTS</span>
            <span>3,000 PTS</span>
            <span>4,000 PTS</span>
          </div>
        </div>

        <!-- Control Mes 2 -->
        <div class="space-y-2 bg-slate-50 dark:bg-purple-950/20 p-4 rounded-2xl border border-slate-100 dark:border-purple-950/50">
          <div class="flex justify-between items-center text-xs font-extrabold uppercase tracking-wider">
            <span class="text-slate-700 dark:text-slate-300">📅 Periodo Mensual 2 (Consecutivo):</span>
            <span class="text-purple-600 dark:text-purple-400 text-sm font-black"><span id="m2-val">3000</span> PTS</span>
          </div>
          <input 
            type="range" 
            id="m2-slider" 
            min="0" 
            max="4000" 
            step="100" 
            value="3000" 
            class="w-full accent-purple-600 cursor-pointer"
          />
          <div class="flex justify-between text-[10px] text-slate-400 font-bold">
            <span>0 PTS</span>
            <span>1,000 PTS</span>
            <span>2,000 PTS</span>
            <span>3,000 PTS</span>
            <span>4,000 PTS</span>
          </div>
        </div>

        <!-- Regla Oficial -->
        <div class="bg-amber-50/80 dark:bg-amber-950/20 p-3.5 rounded-2xl border border-amber-200/60 dark:border-amber-900/40 flex items-start gap-2.5 text-xs text-amber-950 dark:text-amber-200 leading-relaxed">
          <span class="text-base shrink-0">📌</span>
          <div>
            <strong>Regla de Múltiplos para el 40%:</strong> En cada periodo mensual solo se considerarán <strong>múltiplos exactos de 1,000 Puntos</strong> (ejemplo: 1,000, 2,000, 3,000 o 4,000). Si usas puntos de red, debes realizar un mínimo de <strong>500 Puntos Personales (PP)</strong> en ese periodo.
          </div>
        </div>
      </div>

      <!-- Tarjeta Resultado Diagnóstico (5 Cols) -->
      <div class="lg:col-span-5 bg-linear-to-br from-purple-900 via-slate-900 to-purple-950 p-6 sm:p-8 rounded-3xl text-white space-y-6 shadow-xl border border-purple-700/50 relative overflow-hidden">
        <div class="space-y-1 border-b border-purple-800/60 pb-4">
          <span class="text-[10px] font-extrabold uppercase tracking-wider text-purple-300">Diagnóstico de Descuento</span>
          <div class="flex items-baseline justify-between">
            <span class="text-xs text-purple-200 font-semibold">Descuento Obtenido:</span>
            <span id="desc-porcentaje-res" class="text-4xl sm:text-5xl font-black text-amber-400">40%</span>
          </div>
        </div>

        <div class="space-y-3">
          <div class="flex justify-between text-xs">
            <span class="text-purple-300">Puntos Totales Acumulados:</span>
            <span id="puntos-totales-res" class="font-extrabold text-white">4,000 PTS</span>
          </div>
          <div class="flex justify-between text-xs">
            <span class="text-purple-300">Múltiplos de 1,000 Válidos al 40%:</span>
            <span id="puntos-40-validos" class="font-extrabold text-emerald-400">4,000 PTS</span>
          </div>
          <div class="flex justify-between text-xs">
            <span class="text-purple-300">Condición de Nivel:</span>
            <span id="estado-permanencia" class="font-bold text-amber-300">Descuento Mayorista</span>
          </div>
        </div>

        <!-- Barra de Progreso Hacia el 40% -->
        <div class="space-y-1.5">
          <div class="flex justify-between text-[11px] font-extrabold uppercase tracking-wider text-purple-200">
            <span>Progreso al 40%</span>
            <span id="progreso-porcentaje-texto">100%</span>
          </div>
          <div class="w-full h-3 bg-purple-950 rounded-full overflow-hidden p-0.5 border border-purple-700/50">
            <div id="barra-progreso" class="h-full bg-linear-to-r from-purple-500 via-indigo-400 to-amber-400 rounded-full transition-all duration-300" style="width: 100%;"></div>
          </div>
        </div>

        <div id="desc-mensaje-res" class="bg-purple-950/80 p-3.5 rounded-xl border border-purple-800/60 text-xs text-purple-100 leading-relaxed font-medium">
          ¡Felicidades! Has cumplido la calificación al 40% de descuento mayorista.
        </div>
      </div>
    </div>
  </div>

  <!-- 3. Las 4 Combinaciones Ganadoras para el 40% (Bloque 3) -->
  <div class="fade-in-block opacity-0 translate-y-10 transition-all duration-700 ease-out space-y-4">
    <div class="border-b border-slate-200 dark:border-purple-950/60 pb-2">
      <h3 class="text-lg sm:text-xl font-black text-slate-950 dark:text-white flex items-center gap-2">
        <span>🏆</span> Formas de Lograr el 40% en 2 Meses Consecutivos
      </h3>
      <p class="text-xs text-slate-600 dark:text-slate-300 mt-0.5">
        Elige la combinación de Puntos Personales (PP) o Puntos de Red que mejor se adapte a tu meta.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {combinaciones40.map((combo) => (
        <div class="bg-white dark:bg-[#130f24] border border-slate-200/90 dark:border-purple-950/80 p-5 rounded-2xl shadow-xs space-y-3 hover:border-purple-400 transition-all">
          <span class="text-xs font-black text-purple-600 dark:text-purple-400 bg-purple-50 dark:bg-purple-950 px-2.5 py-1 rounded-md inline-block">
            {combo.titulo}
          </span>
          <div class="space-y-1 text-xs font-bold text-slate-800 dark:text-slate-200">
            <div class="flex justify-between">
              <span>1er Mes:</span>
              <span class="text-purple-600 dark:text-purple-400">{combo.m1}</span>
            </div>
            <div class="flex justify-between">
              <span>2do Mes:</span>
              <span class="text-purple-600 dark:text-purple-400">{combo.m2}</span>
            </div>
          </div>
          <p class="text-[11px] text-slate-500 dark:text-slate-400 leading-relaxed pt-1 border-t border-slate-100 dark:border-purple-950/60">
            {combo.desc}
          </p>
        </div>
      ))}
    </div>
  </div>

  <!-- 4. Conservación del 40% y Puntos de Organización (Bloque 4) -->
  <div class="fade-in-block opacity-0 translate-y-10 transition-all duration-700 ease-out grid grid-cols-1 md:grid-cols-2 gap-6">
    <!-- Regla de Conservación del 40% -->
    <div class="bg-amber-50/70 dark:bg-amber-950/20 border border-amber-200/80 dark:border-amber-900/40 p-6 rounded-3xl space-y-2">
      <h4 class="text-sm font-black text-amber-950 dark:text-amber-200 flex items-center gap-2">
        <span>🔒</span> ¿Cómo Conservar el 40% de Descuento?
      </h4>
      <p class="text-xs text-amber-900/90 dark:text-amber-200/90 leading-relaxed">
        Una vez que alcanzas el 40%, para conservarlo deberás completar anualmente <strong>1,500 Puntos Personales (PP)</strong> dentro del periodo que indique OMNILIFE. Si no los completas, tu descuento cambiará al 35%, manteniendo la opción de calificar nuevamente al 40%.
      </p>
    </div>

    <!-- Puntos de Red de hasta 3er Nivel -->
    <div class="bg-purple-50/70 dark:bg-purple-950/20 border border-purple-200/80 dark:border-purple-900/40 p-6 rounded-3xl space-y-2">
      <h4 class="text-sm font-black text-purple-950 dark:text-purple-200 flex items-center gap-2">
        <span>👥</span> Calificación con Puntos de Red
      </h4>
      <p class="text-xs text-purple-900/90 dark:text-purple-200/90 leading-relaxed">
        Puedes sumar los puntos de los Empresarios de tu red de <strong>hasta tres niveles</strong> que no tengan el 40% de descuento ni dependan de alguien que lo tenga. Debes completar al menos <strong>500 PP</strong> en cada periodo mensual para usar este beneficio.
      </p>
    </div>
  </div>

  <!-- 5. Calculadora Financiera de Inversión vs Ganancia por Producto (Bloque 5) -->
  <div class="fade-in-block opacity-0 translate-y-10 transition-all duration-700 ease-out bg-white dark:bg-[#130f24] border border-slate-200/90 dark:border-purple-950/80 p-6 sm:p-8 rounded-3xl shadow-lg space-y-6">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-slate-100 dark:border-purple-950/60 pb-5">
      <div>
        <span class="text-[10px] font-extrabold uppercase tracking-wider text-purple-700 dark:text-purple-300 bg-purple-100 dark:bg-purple-950 px-2.5 py-1 rounded-md inline-block mb-1">
          Planificador Financiero de Menudeo
        </span>
        <h3 class="text-xl font-black text-slate-950 dark:text-white flex items-center gap-2">
          <span>💵</span> Proyección de Inversión y Retorno en Córdobas (C$)
        </h3>
        <p class="text-xs text-slate-600 dark:text-slate-300 mt-1">
          Selecciona un producto bandera para calcular cuántas unidades necesitas comprar, tu capital de inversión requerido y tu ganancia líquida.
        </p>
      </div>

      <!-- Selector de Producto Top -->
      <div class="shrink-0 min-w-60">
        <label for="prod-select" class="block text-[11px] font-extrabold uppercase text-slate-500 dark:text-slate-400 mb-1">
          Producto para la Simulación:
        </label>
        <select id="prod-select" class="w-full bg-slate-50 dark:bg-purple-950/60 border border-slate-200 dark:border-purple-800 text-slate-900 dark:text-white text-xs font-bold rounded-xl p-3 focus:ring-2 focus:ring-purple-500 outline-none cursor-pointer">
          {productosTop.map((p) => (
            <option value={p.id}>{p.nombre} ({p.pts} PTS)</option>
          ))}
        </select>
      </div>
    </div>

    <!-- Grid de Tarjetas de Metas Financieras (3 Columnas) -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <!-- Meta 1: 1,000 PTS (30% Descuento) -->
      <div class="bg-slate-50/80 dark:bg-purple-950/20 border border-slate-200/80 dark:border-purple-900/40 p-6 rounded-2xl space-y-4 relative overflow-hidden">
        <div class="flex items-center justify-between border-b border-slate-200 dark:border-purple-900/40 pb-3">
          <span class="text-xs font-extrabold text-purple-700 dark:text-purple-300">Meta 1: Escalón 30%</span>
          <span class="text-[10px] font-black uppercase bg-purple-100 dark:bg-purple-900 text-purple-900 dark:text-purple-200 px-2 py-0.5 rounded-md">1,000 PTS</span>
        </div>

        <div class="space-y-2 text-xs">
          <div class="flex justify-between">
            <span class="text-slate-500 dark:text-slate-400">Unidades Necesarias:</span>
            <span id="m30-unidades" class="font-black text-slate-900 dark:text-white text-sm">19 Cajas</span>
          </div>
          <div class="flex justify-between">
            <span class="text-slate-500 dark:text-slate-400">Puntos Computados:</span>
            <span id="m30-puntos" class="font-bold text-purple-600 dark:text-purple-400">1,026 PTS</span>
          </div>
          <div class="flex justify-between pt-1 border-t border-slate-200 dark:border-purple-900/30">
            <span class="text-slate-700 dark:text-slate-300 font-semibold">Venta Total Sugerida:</span>
            <span id="m30-venta" class="font-bold text-slate-900 dark:text-white">C$ 22,515.00</span>
          </div>
          <div class="flex justify-between">
            <span class="text-slate-700 dark:text-slate-300 font-semibold">Inversión Necesaria (al 30%):</span>
            <span id="m30-costo" class="font-bold text-slate-900 dark:text-white">C$ 16,429.87</span>
          </div>
        </div>

        <div class="bg-purple-100/70 dark:bg-purple-950/60 p-3.5 rounded-xl border border-purple-200/60 dark:border-purple-800/50 flex justify-between items-center">
          <span class="text-xs font-extrabold text-purple-900 dark:text-purple-200">Ganancia Limpia:</span>
          <span id="m30-ganancia" class="text-base font-black text-purple-700 dark:text-purple-300">C$ 6,085.13</span>
        </div>
      </div>

      <!-- Meta 2: 2,000 PTS (35% Descuento Fijo) -->
      <div class="bg-slate-50/80 dark:bg-purple-950/20 border border-slate-200/80 dark:border-purple-900/40 p-6 rounded-2xl space-y-4 relative overflow-hidden">
        <div class="flex items-center justify-between border-b border-slate-200 dark:border-purple-900/40 pb-3">
          <span class="text-xs font-extrabold text-purple-700 dark:text-purple-300">Meta 2: Nivel Fijo 35%</span>
          <span class="text-[10px] font-black uppercase bg-amber-100 dark:bg-amber-950 text-amber-900 dark:text-amber-200 px-2 py-0.5 rounded-md">2,000 PTS</span>
        </div>

        <div class="space-y-2 text-xs">
          <div class="flex justify-between">
            <span class="text-slate-500 dark:text-slate-400">Unidades Necesarias:</span>
            <span id="m35-unidades" class="font-black text-slate-900 dark:text-white text-sm">38 Cajas</span>
          </div>
          <div class="flex justify-between">
            <span class="text-slate-500 dark:text-slate-400">Puntos Computados:</span>
            <span id="m35-puntos" class="font-bold text-purple-600 dark:text-purple-400">2,052 PTS</span>
          </div>
          <div class="flex justify-between pt-1 border-t border-slate-200 dark:border-purple-900/30">
            <span class="text-slate-700 dark:text-slate-300 font-semibold">Venta Total Sugerida:</span>
            <span id="m35-venta" class="font-bold text-slate-900 dark:text-white">C$ 45,030.00</span>
          </div>
          <div class="flex justify-between">
            <span class="text-slate-700 dark:text-slate-300 font-semibold">Inversión Necesaria (al 35%):</span>
            <span id="m35-costo" class="font-bold text-slate-900 dark:text-white">C$ 30,831.30</span>
          </div>
        </div>

        <div class="bg-amber-100/70 dark:bg-amber-950/60 p-3.5 rounded-xl border border-amber-200/60 dark:border-amber-800/50 flex justify-between items-center">
          <span class="text-xs font-extrabold text-amber-950 dark:text-amber-200">Ganancia Limpia:</span>
          <span id="m35-ganancia" class="text-base font-black text-amber-800 dark:text-amber-300">C$ 14,198.70</span>
