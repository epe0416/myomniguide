      <!-- Meta 3: 4,000 PTS (40% Mayorista) -->
      <div class="bg-linear-to-br from-purple-900 via-slate-900 to-purple-950 text-white p-6 rounded-2xl space-y-4 relative overflow-hidden shadow-xl border border-purple-700/60">
        <div class="flex items-center justify-between border-b border-purple-800/60 pb-3">
          <span class="text-xs font-extrabold text-amber-400">Meta 3: Salto al 40%</span>
          <span class="text-[10px] font-black uppercase bg-amber-400 text-slate-950 px-2 py-0.5 rounded-md">4,000 PTS</span>
