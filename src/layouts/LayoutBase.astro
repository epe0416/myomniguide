---
// src/layouts/LayoutBase.astro
import '../styles/global.css';
import GlosarioModal from '../components/GlosarioModal.astro';
import CurrencyToggle from '../components/CurrencyToggle.astro';
import SearchModal from '../components/SearchModal.astro';
import ThemeToggle from '../components/ThemeToggle.astro';

interface Props {
  titulo?: string;
  title?: string;
  descripcion?: string;
  imagen?: string;
}

const { titulo, title, descripcion, imagen } = Astro.props;
const pageTitle = title || titulo || 'Catálogo';
const descripcionFinal = descripcion || 'Guía técnica y comercial interactiva de productos Omnilife y Seytú.';

const rawBaseUrl = import.meta.env.BASE_URL;
const baseUrl = rawBaseUrl.endsWith('/') ? rawBaseUrl : `${rawBaseUrl}/`;
const currentPath = Astro.url.pathname;

const imagenAbsoluta = imagen
  ? new URL(imagen, Astro.url.origin).href
  : new URL(`${baseUrl}favicon.svg`, Astro.url.origin).href;
---

<!DOCTYPE html>
<html lang="es" class="h-full bg-[#0c0816] scrollbar-gutter-stable overflow-x-hidden dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <title>{pageTitle} | MyOmniGuide</title>
    <meta name="description" content={descripcionFinal} />

    <!-- Script antirrefresco de tema (Modo oscuro por defecto) -->
    <script is:inline>
      const savedTheme = localStorage.getItem('theme');
      if (savedTheme === 'light') {
        document.documentElement.classList.remove('dark');
      } else {
        document.documentElement.classList.add('dark');
      }
    </script>

    <!-- OpenGraph / Tarjeta de WhatsApp -->
    <meta property="og:title" content={`${pageTitle} | MyOmniGuide`} />
    <meta property="og:description" content={descripcionFinal} />
    <meta property="og:image" content={imagenAbsoluta} />
    <meta property="og:type" content={imagen ? 'product' : 'website'} />
    <meta property="og:url" content={Astro.url.href} />
    
    <!-- Favicon SVG -->
    <link rel="icon" type="image/svg+xml" href={`${baseUrl}favicon.svg`} />
  </head>
  <body class="min-h-screen flex flex-col text-slate-900 dark:text-slate-100 bg-slate-50 dark:bg-[#0c0816] antialiased font-sans overflow-x-hidden max-w-full transition-colors duration-200">
    
    <!-- Navbar Sticky -->
    <header class="sticky top-0 z-50 bg-white/85 dark:bg-[#0c0816]/85 backdrop-blur-md border-b border-slate-200/80 dark:border-purple-950/60 shadow-xs">
      <div class="max-w-6xl mx-auto px-2 sm:px-6 h-14 sm:h-16 flex items-center justify-between gap-1 sm:gap-3">
        
        <a href={baseUrl} class="flex items-center gap-2 group shrink-0">
          <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-xl bg-purple-900 border border-purple-700/50 flex items-center justify-center text-white font-black text-base sm:text-lg shadow-xs group-hover:bg-purple-800 transition-colors">
            O
          </div>
          <span class="hidden sm:inline text-lg font-extrabold tracking-tight text-slate-950 dark:text-white">
            My<span class="text-purple-600 dark:text-purple-400">OmniGuide</span>
          </span>
        </a>

        <!-- Bloque Derecho: Navegación + Buscador + Conmutadores -->
        <div class="flex items-center gap-1 sm:gap-2.5 shrink-0">
          <nav class="flex items-center gap-0.5 sm:gap-1">
            <!-- Oculto en móviles muy pequeños ya que el logo lleva al inicio -->
            <a 
              href={baseUrl} 
              class={`px-1.5 sm:px-3 py-1 sm:py-1.5 rounded-lg text-[11px] sm:text-sm font-semibold transition-all hidden xs:inline-block sm:inline-block ${
                currentPath === rawBaseUrl || currentPath === baseUrl
                  ? 'bg-purple-50 dark:bg-purple-950/60 text-purple-700 dark:text-purple-300'
                  : 'text-slate-600 dark:text-slate-400 hover:text-slate-950 dark:hover:text-white hover:bg-slate-100/80 dark:hover:bg-purple-950/30'
              }`}
            >
              Inicio
            </a>

            <a 
              href={`${baseUrl}productos`} 
              class={`px-1.5 sm:px-3 py-1 sm:py-1.5 rounded-lg text-[11px] sm:text-sm font-semibold transition-all ${
                currentPath.includes('productos')
                  ? 'bg-purple-50 dark:bg-purple-950/60 text-purple-700 dark:text-purple-300'
                  : 'text-slate-600 dark:text-slate-400 hover:text-slate-950 dark:hover:text-white hover:bg-slate-100/80 dark:hover:bg-purple-950/30'
              }`}
            >
              Catálogo
            </a>

            <a 
              href={`${baseUrl}combos`} 
              class={`px-1.5 sm:px-3 py-1 sm:py-1.5 rounded-lg text-[11px] sm:text-sm font-semibold transition-all ${
                currentPath.includes('combos')
                  ? 'bg-purple-50 dark:bg-purple-950/60 text-purple-700 dark:text-purple-300'
                  : 'text-slate-600 dark:text-slate-400 hover:text-slate-950 dark:hover:text-white hover:bg-slate-100/80 dark:hover:bg-purple-950/30'
              }`}
            >
              Combos
            </a>
          </nav>

          <!-- Modal de Búsqueda Global -->
          <SearchModal />

          <!-- Conmutador NIO / USA -->
          <CurrencyToggle />

          <!-- Interruptor Dark/Light Mode -->
          <ThemeToggle />
        </div>

      </div>
    </header>

    <!-- Contenido Principal -->
    <main class="max-w-6xl mx-auto px-4 sm:px-6 py-6 sm:py-8 flex-1 w-full overflow-x-hidden">
      <slot />
    </main>

    <!-- Footer Compacto -->
    <footer class="border-t border-slate-200 dark:border-purple-950/60 bg-white dark:bg-[#0c0816] py-6 mt-auto transition-colors">
      <div class="max-w-6xl mx-auto px-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500 dark:text-slate-400 font-medium">
        
        <p>© {new Date().getFullYear()} MyOmniGuide. Guía independiente de consulta técnica.</p>

        <div class="flex items-center gap-4">
          <button 
            id="btn-abrir-aviso-legal" 
            type="button" 
            class="text-slate-500 dark:text-slate-400 hover:text-purple-700 dark:hover:text-purple-300 underline underline-offset-2 transition-colors cursor-pointer font-semibold"
          >
            Aviso Legal & Deslinde
          </button>
          
          <span class="text-slate-300 dark:text-purple-900">|</span>

          <p class="text-slate-400 dark:text-slate-500">
            Desarrollado por{' '}
            <a 
              href="https://github.com/epe0416" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="text-purple-700 dark:text-purple-400 hover:text-purple-900 dark:hover:text-purple-300 font-bold underline decoration-purple-300 dark:decoration-purple-800 underline-offset-2 transition-colors"
            >
              epedev
            </a>
          </p>
        </div>

      </div>
    </footer>

    <!-- Modal de Aviso Legal -->
    <dialog 
      id="modal-aviso-legal" 
      class="backdrop:bg-slate-950/70 backdrop:backdrop-blur-xs rounded-2xl max-w-xl w-[90%] p-0 border border-slate-200 dark:border-purple-900/50 bg-white dark:bg-[#130f24] text-slate-900 dark:text-slate-100 shadow-2xl m-auto"
    >
      <div class="p-6 space-y-4">
        <div class="flex items-center justify-between border-b border-slate-100 dark:border-purple-950/60 pb-3">
          <h3 class="font-extrabold text-slate-900 dark:text-white text-sm uppercase tracking-wider flex items-center gap-2">
            ⚠️ Aviso Legal y Deslinde de Responsabilidad
          </h3>
          <button 
            id="btn-cerrar-aviso-legal" 
            type="button" 
            aria-label="Cerrar aviso legal"
            class="text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 text-lg font-bold px-2 py-1 cursor-pointer transition-colors"
          >
            ✕
          </button>
        </div>

        <div class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed space-y-3 max-h-[60vh] overflow-y-auto pr-1">
          <p>
            <strong>MyOmniGuide</strong> es una herramienta de consulta técnica e informativa de carácter independiente, creada por un Distribuidor Independiente para la capacitación y apoyo de la comunidad de distribuidores y consumidores. <strong>No es un sitio web oficial ni está afiliado operativamente con Omnilife Inc.</strong>
          </p>
          <p>
            Los productos mostrados en este catálogo son <strong>suplementos alimenticios formulados para aportar nutrientes de alta absorción, antioxidantes y extractos vegetales que apoyan el funcionamiento biológico natural y el confort del organismo</strong>. No son medicamentos, por lo que no sustituyen una alimentación balanceada, un estilo de vida activo ni la prescripción o diagnóstico de un profesional de la salud.
          </p>
          <p>
            La información técnica, listas de ingredientes y puntuación oficial de volumen de los productos están referenciadas conforme a la <strong>actualización de 2026</strong>, recopilada de fuentes públicas y material de entrenamiento comercial.
          </p>
        </div>

        <div class="pt-2 border-t border-slate-100 dark:border-purple-950/60 text-right">
          <button 
            id="btn-entendido-aviso-legal" 
            type="button" 
            class="px-4 py-2 bg-purple-900 dark:bg-purple-800 text-white font-bold text-xs rounded-xl hover:bg-purple-950 dark:hover:bg-purple-700 transition-colors cursor-pointer"
          >
            Entendido
          </button>
        </div>
      </div>
    </dialog>

    <GlosarioModal />

    <script is:inline>
      document.addEventListener('DOMContentLoaded', () => {
        const dialog = document.getElementById('modal-aviso-legal');
        const btnAbrir = document.getElementById('btn-abrir-aviso-legal');
        const btnCerrar = document.getElementById('btn-cerrar-aviso-legal');
        const btnEntendido = document.getElementById('btn-entendido-aviso-legal');

        if (!dialog) return;

        btnAbrir?.addEventListener('click', () => dialog.showModal());
        btnCerrar?.addEventListener('click', () => dialog.close());
        btnEntendido?.addEventListener('click', () => dialog.close());

        dialog.addEventListener('click', (e) => {
          const rect = dialog.getBoundingClientRect();
          const inDialog = 
            rect.top <= e.clientY && 
            e.clientY <= rect.bottom && 
            rect.left <= e.clientX && 
            e.clientX <= rect.right;
          if (!inDialog) dialog.close();
        });
      });
    </script>

  </body>
</html>