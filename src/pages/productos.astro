---
// src/pages/productos.astro
import LayoutBase from '../layouts/LayoutBase.astro';
import TarjetaProducto from '../components/TarjetaProducto.astro';
import { getCollection } from 'astro:content';
import { getProductoComercial } from '../data/inventario';

const productos = await getCollection('productos');

const categoriasUnicas = Array.from(
  new Set(productos.flatMap((p) => p.data.categorias))
).sort();
---

<LayoutBase titulo="Catálogo de Productos | OmniGrowth">
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-12">
    <!-- Encabezado -->
    <div class="mb-8">
      <h1 class="text-3xl md:text-4xl font-black text-slate-950 dark:text-white tracking-tight mb-2">
        Catálogo Completo de Productos
      </h1>
      <p class="text-slate-600 dark:text-slate-300 text-sm md:text-base max-w-2xl">
        Explora las fichas técnicas, argumentos comerciales y puntuación oficial de volumen para potenciar tus ventas.
      </p>
    </div>

    <!-- Buscador y Filtro por Categorías -->
    <div class="mb-8 space-y-4">
      <div class="relative max-w-xl">
        <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400 dark:text-slate-500">
          🔍
        </div>
        <input 
          type="search" 
          id="buscador-productos" 
          placeholder="Buscar por nombre o beneficio..."
          class="w-full pl-10 pr-4 py-3 bg-white dark:bg-[#130f24] border border-slate-200 dark:border-purple-950/60 rounded-xl text-sm text-slate-900 dark:text-slate-100 placeholder-slate-400 dark:placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-purple-600 dark:focus:ring-purple-500 focus:border-transparent transition-all shadow-xs"
        />
      </div>

      <div class="flex items-center gap-2 overflow-x-auto pb-2 scrollbar-none" id="contenedor-categorias">
        <button
          type="button"
          class="btn-categoria active whitespace-nowrap px-4 py-2 rounded-xl text-xs font-bold transition-all cursor-pointer bg-purple-950 dark:bg-purple-900 text-white shadow-xs border border-transparent"
          data-category="todas"
        >
          Todas ({productos.length})
        </button>
        {categoriasUnicas.map((cat) => (
          <button
            type="button"
            class="btn-categoria whitespace-nowrap px-4 py-2 rounded-xl text-xs font-bold transition-all cursor-pointer bg-white dark:bg-[#130f24] text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-purple-950/60 hover:border-purple-300 dark:hover:border-purple-500/50 hover:text-purple-900 dark:hover:text-purple-300 shadow-xs"
            data-category={cat.toLowerCase()}
          >
            {cat}
          </button>
        ))}
      </div>

      <div class="text-xs text-slate-500 dark:text-slate-400 flex justify-between items-center px-1">
        <span id="contador-resultados">Cargando productos...</span>
        <button 
          id="btn-limpiar" 
          class="text-purple-700 dark:text-purple-400 hover:text-purple-900 dark:hover:text-purple-300 font-bold hidden cursor-pointer transition-colors"
        >
          Limpiar filtros
        </button>
      </div>
    </div>

    <!-- Grid de Productos -->
    <div id="grid-productos" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {productos.map((item) => {
        const comercial = getProductoComercial(item.id);
        const disponibleNIO = !!comercial?.nio;
        const disponibleUSA = !!comercial?.usa;
        const searchText = `${item.data.nombre} ${item.data.beneficiosPrincipales.join(' ')}`.toLowerCase();
        const categoriasAttr = item.data.categorias.map(c => c.toLowerCase()).join('|');
        return (
          <div 
            class="tarjeta-item hidden transition-all duration-300" 
            data-search={searchText}
            data-categories={categoriasAttr}
            data-has-nio={disponibleNIO ? "true" : "false"}
            data-has-usa={disponibleUSA ? "true" : "false"}
          >
            <TarjetaProducto
              slug={item.id}
              nombre={item.data.nombre}
              categorias={item.data.categorias}
              beneficioPrincipal={item.data.beneficiosPrincipales[0]}
              formato={item.data.formato}
              imagen={item.data.imagen}
            />
          </div>
        );
      })}
    </div>

    <div id="scroll-sentinel" class="h-12 flex items-center justify-center mt-6">
      <div id="cargando-indicador" class="hidden text-xs text-slate-400 dark:text-slate-500 font-medium">
        Cargando más productos...
      </div>
    </div>

    <div 
      id="sin-resultados" 
      class="hidden text-center py-16 bg-white dark:bg-[#130f24] rounded-2xl border border-slate-200 dark:border-purple-950/60 shadow-xs mt-6"
    >
      <div class="text-4xl mb-3">🔍</div>
      <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-1">No se encontraron productos</h3>
      <p class="text-slate-500 dark:text-slate-400 text-sm max-w-md mx-auto mb-4">
        No coinciden productos con el criterio seleccionado. Intenta cambiar de categoría o modificar el texto de búsqueda.
      </p>
    </div>
  </main>
</LayoutBase>

<style>
  /* Regla estricta para asegurar que los productos no disponibles en la región se oculten */
  .tarjeta-item.region-hidden {
    display: none !important;
  }
</style>

<script>
  import { initCatalogo } from '../scripts/catalogoFiltros';

  document.addEventListener('DOMContentLoaded', () => {
    initCatalogo();

    function filtrarPorRegion() {
      let moneda = localStorage.getItem('moneda_pref') || 'NIO';
      if (moneda === 'USD') moneda = 'USA';

      let disponiblesCount = 0;

      document.querySelectorAll('.tarjeta-item').forEach((item) => {
        const hasNio = item.getAttribute('data-has-nio') === 'true';
        const hasUsa = item.getAttribute('data-has-usa') === 'true';
        
        const disponible = moneda === 'USA' ? hasUsa : hasNio;

        if (!disponible) {
          item.classList.add('region-hidden');
        } else {
          item.classList.remove('region-hidden');
          disponiblesCount++;
        }
      });

      // Actualizar dinámicamente el texto del botón "Todas" con el total real de la región
      const btnTodas = document.querySelector('.btn-categoria[data-category="todas"]');
      if (btnTodas) {
        btnTodas.textContent = `Todas (${disponiblesCount})`;
      }

      // Forzar al script de filtros a recalcular resultados y contadores visuales
      const buscador = document.getElementById('buscador-productos') as HTMLInputElement;
      if (buscador) {
        buscador.dispatchEvent(new Event('input', { bubbles: true }));
      }
    }

    filtrarPorRegion();
    window.addEventListener('currency-changed', filtrarPorRegion);
  });
</script>