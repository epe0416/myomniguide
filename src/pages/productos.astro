---
import LayoutBase from '../layouts/LayoutBase.astro';
import TarjetaProducto from '../components/TarjetaProducto.astro';
import { getCollection } from 'astro:content';

const productos = await getCollection('productos');
---

<LayoutBase titulo="Catálogo de Productos | OmniGrowth">
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-12">
    <!-- Encabezado -->
    <div class="mb-8">
      <h1 class="text-3xl md:text-4xl font-black text-slate-950 tracking-tight mb-2">
        Catálogo Completo de Productos
      </h1>
      <p class="text-slate-600 text-sm md:text-base max-w-2xl">
        Explora las fichas técnicas, argumentos comerciales y puntuación oficial de volumen para potenciar tus ventas.
      </p>
    </div>

    <!-- Campo de Búsqueda -->
    <div class="mb-8 max-w-xl">
      <div class="relative">
        <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
          🔍
        </div>
        <input 
          type="search" 
          id="buscador-productos" 
          placeholder="Buscar por nombre, categoría o beneficio..."
          class="w-full pl-10 pr-4 py-3 bg-white border border-slate-200 rounded-xl text-sm text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-purple-600 focus:border-transparent transition-all shadow-xs"
        />
      </div>
      
      <!-- Metadata de Búsqueda -->
      <div class="mt-2 text-xs text-slate-500 flex justify-between items-center px-1">
        <span id="contador-resultados">Mostrando {productos.length} productos</span>
        <button 
          id="btn-limpiar" 
          class="text-purple-700 hover:text-purple-900 font-bold hidden cursor-pointer transition-colors"
        >
          Limpiar búsqueda
        </button>
      </div>
    </div>

    <!-- Grid de Productos -->
    <div id="grid-productos" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {productos.map((item) => {
        const searchText = `${item.data.nombre} ${item.data.categorias.join(' ')} ${item.data.beneficiosPrincipales.join(' ')}`.toLowerCase();
        return (
          <div class="tarjeta-item transition-all duration-200" data-search={searchText}>
            <TarjetaProducto
              slug={item.id}
              nombre={item.data.nombre}
              puntos={item.data.puntos}
              categorias={item.data.categorias}
              beneficioPrincipal={item.data.beneficiosPrincipales[0]}
              formato={item.data.formato}
              imagen={item.data.imagen}
            />
          </div>
        );
      })}
    </div>

    <!-- Estado Vacío (Sin Resultados) -->
    <div 
      id="sin-resultados" 
      class="hidden text-center py-16 bg-white rounded-2xl border border-slate-200 shadow-xs mt-6"
    >
      <div class="text-4xl mb-3">🔍</div>
      <h3 class="text-lg font-bold text-slate-900 mb-1">No se encontraron productos</h3>
      <p class="text-slate-500 text-sm max-w-md mx-auto mb-4">
        No coinciden productos con el criterio de búsqueda. Intenta con otros términos como "Energía", "Digestivo" o "Omniplus".
      </p>
    </div>
  </main>
</LayoutBase>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const inputBuscador = document.getElementById('buscador-productos');
    const tarjetas = document.querySelectorAll('.tarjeta-item');
    const sinResultados = document.getElementById('sin-resultados');
    const contador = document.getElementById('contador-resultados');
    const btnLimpiar = document.getElementById('btn-limpiar');

    if (!inputBuscador) return;

    function filtrarProductos() {
      const query = inputBuscador.value.trim().toLowerCase();
      let visibles = 0;

      tarjetas.forEach((tarjeta) => {
        const searchData = tarjeta.getAttribute('data-search') || '';
        const coincide = searchData.includes(query);

        if (coincide) {
          tarjeta.classList.remove('hidden');
          visibles++;
        } else {
          tarjeta.classList.add('hidden');
        }
      });

      // Actualizar contador dinámico
      if (contador) {
        contador.textContent = query === '' 
          ? `Mostrando ${tarjetas.length} productos` 
          : `${visibles} ${visibles === 1 ? 'producto encontrado' : 'productos encontrados'}`;
      }

      // Mostrar / ocultar botón de limpiar
      if (btnLimpiar) {
        btnLimpiar.classList.toggle('hidden', query === '');
      }

      // Mostrar estado vacío si no hay coincidencias
      if (sinResultados) {
        sinResultados.classList.toggle('hidden', visibles > 0);
      }
    }

    inputBuscador.addEventListener('input', filtrarProductos);

    btnLimpiar?.addEventListener('click', () => {
      inputBuscador.value = '';
      filtrarProductos();
      inputBuscador.focus();
    });
  });
</script>