---
// src/pages/index.astro
import LayoutBase from '../layouts/LayoutBase.astro';
import TarjetaProducto from '../components/TarjetaProducto.astro';
import HeroCarousel from '../components/HeroCarousel.astro';
import { getCollection } from 'astro:content';

const productos = await getCollection('productos');
const productosDestacados = productos.filter((p) => p.data.destacado);

const rawBaseUrl = import.meta.env.BASE_URL;
const baseUrl = rawBaseUrl.endsWith('/') ? rawBaseUrl : `${rawBaseUrl}/`;
---

<LayoutBase titulo="Inicio - MyOmniGuide">
  <!-- Carrusel Dinámico Principal -->
  <HeroCarousel />

  <!-- Sección de Productos Destacados -->
  <section class="mb-12 mt-8">
    <div class="flex justify-between items-end mb-6">
      <div>
        <h2 class="text-2xl font-extrabold text-slate-950">Productos Destacados</h2>
        <p class="text-slate-700 text-sm mt-1">Los suplementos de mayor impacto en el catálogo.</p>
      </div>
      <a 
        href={`${baseUrl}productos`} 
        class="text-xs font-bold text-purple-800 hover:text-purple-950 transition-colors hidden sm:inline-block"
      >
        Ver catálogo completo →
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {productosDestacados.map((item) => (
        <div class="h-full flex flex-col">
          <TarjetaProducto
            slug={item.id}
            nombre={item.data.nombre}
            categorias={item.data.categorias}
            beneficioPrincipal={item.data.beneficiosPrincipales[0]}
            formato={item.data.formato}
            imagen={item.data.imagen}
            loading="eager"
            fetchpriority="high"
          />
        </div>
      ))}
    </div>

    <div class="mt-8 text-center sm:hidden">
      <a 
        href={`${baseUrl}productos`} 
        class="inline-block text-xs font-bold text-purple-800 hover:text-purple-950 transition-colors"
      >
        Ver catálogo completo →
      </a>
    </div>
  </section>
</LayoutBase>