---
// src/pages/productos/[...id].astro
import LayoutBase from '../../layouts/LayoutBase.astro';
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import PrecioBadge from '../../components/PrecioBadge.astro';
import ShareWhatsApp from '../../components/ShareWhatsApp.astro';
import { getProductoComercial } from '../../data/inventario';

export async function getStaticPaths() {
  const productos = await getCollection('productos');
  return productos.map((producto) => ({
    params: { id: producto.id },
    props: { producto },
  }));
}

const { producto } = Astro.props;
const { Content } = await render(producto);
const { data } = producto;

// Consulta limpia y centralizada
const infoComercial = getProductoComercial(producto.id);
const codigoSKU = infoComercial?.codigo;
const precioNIO = infoComercial?.nio?.precio;
const precioUSD = infoComercial?.usa?.precio;
const puntosNIO = infoComercial?.nio?.puntos;
const puntosUSD = infoComercial?.usa?.puntos;
const puntosIniciales = puntosNIO ?? puntosUSD ?? 0;

const rawBaseUrl = import.meta.env.BASE_URL;
const baseUrl = rawBaseUrl.endsWith('/') ? rawBaseUrl : `${rawBaseUrl}/`;

// Verificamos si este producto en particular tiene imagen de catálogo configurada
const tieneCatalogo = Boolean(data.imagenCatalogo);
---

<LayoutBase 
  titulo={`${data.nombre} - Ficha Técnica`}
  descripcion={data.subtitulo}
  imagen={data.imagen?.src}
>
  <div class="mb-6 flex items-center justify-between">
    <a href={`${baseUrl}productos`} class="text-xs font-bold text-purple-700 dark:text-purple-400 hover:text-purple-900 dark:hover:text-purple-300 transition-colors">
      ← Volver al catálogo
    </a>
    {codigoSKU && (
      <span class="text-xs font-mono bg-slate-100 dark:bg-purple-950/60 px-2 py-1 rounded text-slate-500 dark:text-slate-400 border border-slate-200 dark:border-purple-900/40">
        SKU: {codigoSKU}
      </span>
    )}
  </div>

  <div class="bg-white dark:bg-[#130f24] p-6 md:p-8 rounded-3xl border border-slate-200/80 dark:border-purple-950/60 shadow-xs dark:shadow-[0_0_25px_rgba(147,51,235,0.15)] mb-8 grid grid-cols-1 md:grid-cols-12 gap-6 md:gap-8 items-center min-h-70">
    {data.imagen && (
      <div class={`md:col-span-4 flex justify-center items-center bg-slate-50 dark:bg-purple-950/25 p-6 rounded-2xl border border-slate-100 dark:border-purple-950/40 h-64 w-full aspect-square shrink-0 relative ${tieneCatalogo ? 'group cursor-pointer' : ''}`}
           {...(tieneCatalogo ? { id: 'open-catalog-modal' } : {})}>
        
        <Image 
          src={data.imagen} 
          alt={`Imagen del producto ${data.nombre}`} 
          class="max-h-52 w-auto object-contain drop-shadow-md transition-transform duration-300 group-hover:scale-[1.02]"
          width={400}
          height={400}
          loading="eager"
          fetchpriority="high"
        />

        {/* Overlay indicador solo si existe el catálogo para este producto */}
        {tieneCatalogo && (
          <div class="absolute inset-0 bg-purple-950/50 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center rounded-2xl text-white font-bold text-xs gap-1.5 backdrop-blur-[2px] shadow-lg">
            <span>🔍 Ver ficha oficial</span>
          </div>
        )}
      </div>
    )}
    
    <div class={data.imagen ? "md:col-span-8" : "md:col-span-12"}>
      <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
        <div class="flex flex-wrap gap-1.5">
          {data.categorias.map((cat) => (
            <span class="inline-block text-xs font-bold tracking-wider text-purple-900 dark:text-purple-300 bg-purple-100 dark:bg-purple-950/80 px-3 py-1 rounded-md uppercase">
              {cat}
            </span>
          ))}
        </div>

        {puntosIniciales > 0 && (
          <span 
            class="pts-badge inline-flex items-center gap-1 text-xs font-black text-purple-950 dark:text-purple-200 bg-purple-100/80 dark:bg-purple-950/80 px-3 py-1 rounded-xl border border-purple-200/60 dark:border-purple-900/50 shrink-0"
            data-nio-pts={puntosNIO ? `💎 ${puntosNIO} PTS` : ''}
            data-usa-pts={puntosUSD ? `💎 ${puntosUSD} PTS` : 'No disponible en USA'}
          >
            <span class="pts-value">💎 {puntosIniciales} PTS</span>
          </span>
        )}
      </div>

      <h1 class="text-3xl md:text-4xl font-extrabold text-slate-950 dark:text-white mb-2">{data.nombre}</h1>
      <p class="text-slate-700 dark:text-slate-300 text-lg mb-4" set:html={data.subtitulo} />

      <div class="flex flex-wrap items-center gap-3 mt-4">
        <div class="inline-flex items-center gap-2 text-xs font-semibold text-slate-700 dark:text-slate-300 bg-slate-100 dark:bg-purple-950/40 px-3 py-1.5 rounded-lg border border-slate-200/60 dark:border-purple-900/40">
          <span>📦 Formato:</span>
          <strong class="text-slate-900 dark:text-white">{data.formato}</strong>
        </div>

        {(precioNIO || precioUSD) && (
          <div class="inline-flex items-center gap-1.5 text-xs font-semibold text-slate-700 bg-emerald-50 dark:bg-emerald-950/30 border border-emerald-200/80 dark:border-emerald-900/50 px-3 py-1.5 rounded-lg">
            <span class="text-emerald-800 dark:text-emerald-400 font-bold">🏷️ Precio:</span>
            <PrecioBadge precioNIO={precioNIO} precioUSD={precioUSD} />
          </div>
        )}

        <ShareWhatsApp 
          nombre={data.nombre}
          subtitulo={data.subtitulo}
          precioNIO={precioNIO}
          precioUSD={precioUSD}
        />
      </div>
    </div>
  </div>

  {/* Resto de pestañas y contenido de consumo/empresario (sin cambios) */}
  <div class="flex border border-slate-200/80 dark:border-purple-950/60 mb-8 bg-slate-100 dark:bg-purple-950/30 p-1.5 rounded-2xl max-w-md mx-auto">
    <button
      id="tab-consumidor"
      class="tab-btn flex-1 py-2.5 px-4 rounded-xl text-sm font-bold transition-all duration-200 cursor-pointer bg-white dark:bg-purple-900 text-purple-900 dark:text-white shadow-xs"
      data-target="panel-consumidor"
    >
      🥤 Guía de Uso
    </button>
    <button
      id="tab-empresario"
      class="tab-btn flex-1 py-2.5 px-4 rounded-xl text-sm font-bold transition-all duration-200 cursor-pointer text-slate-700 dark:text-slate-400 hover:text-purple-900 dark:hover:text-white hover:bg-white/60 dark:hover:bg-purple-950/40"
      data-target="panel-empresario"
    >
      💼 Guía Comercial
    </button>
  </div>

  <div id="panel-consumidor" class="tab-panel space-y-8">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="bg-purple-50/70 dark:bg-purple-950/20 border border-purple-200/80 dark:border-purple-900/50 p-6 rounded-2xl">
        <h2 class="font-bold text-purple-950 dark:text-purple-300 mb-4 flex items-center gap-2 text-base">
          <span class="text-purple-700 dark:text-purple-400">✨</span> Beneficios Clave
        </h2>
        <ul class="space-y-2.5 text-slate-800 dark:text-slate-200 text-sm">
          {data.beneficiosPrincipales.map((b) => (
            <li class="flex items-start gap-2">
              <span class="text-purple-700 dark:text-purple-400 font-bold">•</span>
              <span set:html={b} />
            </li>
          ))}
        </ul>
      </div>

      <div class="bg-white dark:bg-[#130f24] border border-slate-200 dark:border-purple-950/60 p-6 rounded-2xl shadow-xs">
        <h2 class="font-bold text-slate-950 dark:text-white mb-4 flex items-center gap-2 text-base">
          <span class="text-purple-700 dark:text-purple-400">⚡</span> Modo de Uso Recomendado
        </h2>
        <p class="text-slate-800 dark:text-slate-300 text-sm leading-relaxed mb-6">{data.modoUso}</p>

        <h3 class="font-bold text-slate-900 dark:text-slate-200 text-xs uppercase tracking-wider mb-2">Ideal para:</h3>
        <div class="flex flex-wrap gap-2">
          {data.paraQuienEs.map((p) => (
            <span class="text-xs bg-slate-100 dark:bg-purple-950/60 text-slate-800 dark:text-slate-300 px-3 py-1 rounded-md font-semibold border border-slate-200 dark:border-purple-900/50">
              {p}
            </span>
          ))}
        </div>
      </div>
    </div>

    <div class="bg-white dark:bg-[#130f24] p-8 rounded-2xl border border-slate-200 dark:border-purple-950/60 shadow-xs prose prose-purple dark:prose-invert max-w-none">
      <Content />
    </div>
  </div>

  <div id="panel-empresario" class="tab-panel hidden space-y-6">
    {data.empresario ? (
      <>
        <div class="bg-purple-900 dark:bg-purple-950 text-white p-5 rounded-2xl mb-6 flex items-center justify-between shadow-xs border border-purple-800/50">
          <div>
            <span class="text-xs font-bold text-purple-200 uppercase tracking-wider block mb-0.5">
              Puntuación de Volumen Oficial
            </span>
            <p class="text-xs text-purple-100">
              Utiliza este valor para calcular metas de descuento (25% al 40%) y listas de calificación.
            </p>
          </div>
          <div 
            class="pts-badge bg-white dark:bg-purple-900 text-purple-950 dark:text-white font-black text-2xl px-4 py-2 rounded-xl shadow-xs shrink-0 flex items-center gap-1 border border-purple-700/30"
            data-nio-pts={puntosNIO ? `${puntosNIO}` : ''}
            data-usa-pts={puntosUSD ? `${puntosUSD}` : 'No disponible en USA'}
          >
            <span>💎</span>
            <span class="pts-num">{puntosIniciales}</span>
            <span class="text-xs font-bold text-purple-800 dark:text-purple-300">PTS</span>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="bg-emerald-50/70 dark:bg-emerald-950/25 border border-emerald-200/80 dark:border-emerald-900/50 p-6 rounded-2xl">
            <h2 class="font-bold text-emerald-950 dark:text-emerald-300 mb-3 flex items-center gap-2 text-base">
              <span>✅</span> Lo que SÍ hace el producto
            </h2>
            <ul class="space-y-2 text-emerald-950 dark:text-emerald-200 text-sm">
              {data.empresario.loQueHace.map((item) => (
                <li class="flex items-start gap-2">
                  <span class="font-bold text-emerald-700 dark:text-emerald-400">✓</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>

          <div class="bg-amber-50/70 dark:bg-amber-950/25 border border-amber-200/80 dark:border-amber-900/50 p-6 rounded-2xl">
            <h2 class="font-bold text-amber-950 dark:text-amber-300 mb-3 flex items-center gap-2 text-base">
              <span>🛡️</span> Alcance Nutricional y Límites Técnicos
            </h2>
            <ul class="space-y-2.5 text-slate-800 dark:text-slate-200 text-sm">
              {data.beneficiosPrincipales.map((b) => (
                <li class="flex items-start gap-2">
                  <span class="text-purple-700 dark:text-purple-400 font-bold">•</span>
                  <span set:html={b} />
                </li>
              ))}
            </ul>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="bg-slate-950 dark:bg-[#130f24] text-white p-6 rounded-2xl shadow-xs flex flex-col justify-between border border-slate-800 dark:border-purple-950/60">
            <div>
              <h2 class="text-base font-bold text-purple-300 mb-4 flex items-center gap-2">
                🎯 Enfoque Recomendado
              </h2>
              <ul class="space-y-3 text-slate-100 text-sm">
                {data.empresario.argumentosVenta.map((arg) => (
                  <li class="flex items-start gap-2.5">
                    <span class="text-purple-400 font-bold">➔</span>
                    <span class="leading-relaxed">{arg}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>

          {data.empresario.tipsDemostra && (
            <div class="bg-purple-950 dark:bg-[#130f24] text-white p-6 rounded-2xl shadow-xs flex flex-col justify-between border border-purple-900 dark:border-purple-950/60">
              <div>
                <h2 class="text-base font-bold text-amber-300 mb-4 flex items-center gap-2">
                  ✨ Tips de Experiencia
                </h2>
                <ul class="space-y-3 text-purple-100 text-sm">
                  {data.empresario.tipsDemostra.map((tip) => (
                    <li class="flex items-start gap-2.5">
                      <span class="text-amber-400 font-bold">★</span>
                      <span class="leading-relaxed">{tip}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          )}
        </div>
      </>
    ) : (
      <div class="bg-slate-100 dark:bg-purple-950/30 p-8 rounded-2xl text-center text-slate-700 dark:text-slate-300 text-sm font-medium border border-slate-200 dark:border-purple-900/50">
        Este producto aún no cuenta con información en la guía comercial.
      </div>
    )}
  </div>

  {/* Modal Nativo Opcional para la Ficha del Catálogo */}
  {tieneCatalogo && (
    <dialog id="catalog-modal" class="p-0 bg-transparent rounded-2xl backdrop:bg-black/80 max-w-4xl w-[92%] outline-none shadow-2xl m-auto">
      <div class="bg-white dark:bg-[#120e26] rounded-2xl overflow-hidden border border-slate-200 dark:border-purple-900/50 flex flex-col max-h-[90vh]">
        
        {/* Header del Modal */}
        <div class="flex items-center justify-between px-6 py-4 border-b border-slate-200 dark:border-purple-950/60 bg-slate-50 dark:bg-[#0c0816]">
          <div class="flex items-center gap-2">
            <span class="text-purple-600 dark:text-purple-400 font-bold">📄</span>
            <h3 class="font-bold text-slate-800 dark:text-slate-100 text-sm sm:text-base">
              Ficha Oficial - {data.nombre}
            </h3>
          </div>
          <button 
            id="close-catalog-modal" 
            class="text-slate-400 hover:text-slate-700 dark:hover:text-white text-xl font-bold cursor-pointer p-1 transition-colors"
            aria-label="Cerrar modal"
          >
            ✕
          </button>
        </div>
        
        {/* Contenedor de la imagen */}
        <div class="relative p-4 overflow-hidden max-h-[75vh] flex items-center justify-center bg-slate-950/5 dark:bg-black/40 select-none">
          
          {/* Indicador flotante de Zoom */}
          <div class="absolute top-6 right-6 z-20 flex items-center gap-1 bg-slate-900/90 backdrop-blur-md px-3 py-1.5 rounded-xl border border-purple-900/50 text-white text-xs shadow-lg pointer-events-none">
            <span class="text-slate-400">Zoom:</span>
            <span id="zoom-level" class="font-mono text-purple-300 font-bold">100%</span>
          </div>

          {/* Imagen interactiva */}
          <div class="w-full flex justify-center py-6 overflow-hidden">
            <Image 
              id="catalog-img"
              src={data.imagenCatalogo!} 
              alt={`Catálogo oficial de ${data.nombre}`} 
              class="max-h-[70vh] w-auto object-contain rounded-lg shadow-md transition-transform duration-100 origin-center cursor-zoom-in" 
            />
          </div>
        </div>

      </div>
    </dialog>
  )}
</LayoutBase>

<script is:inline>
  function initTabs() {
    const buttons = document.querySelectorAll('.tab-btn');
    const panels = document.querySelectorAll('.tab-panel');

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetId = btn.getAttribute('data-target');

        buttons.forEach((b) => {
          b.classList.remove('bg-white', 'dark:bg-purple-900', 'text-purple-900', 'dark:text-white', 'shadow-xs');
          b.classList.add('text-slate-700', 'dark:text-slate-400', 'hover:text-purple-900', 'dark:hover:text-white', 'hover:bg-white/60', 'dark:hover:bg-purple-950/40');
        });

        btn.classList.add('bg-white', 'dark:bg-purple-900', 'text-purple-900', 'dark:text-white', 'shadow-xs');
        btn.classList.remove('text-slate-700', 'dark:text-slate-400', 'hover:text-purple-900', 'dark:hover:text-white', 'hover:bg-white/60', 'dark:hover:bg-purple-950/40');

        panels.forEach((p) => {
          if (p.id === targetId) {
            p.classList.remove('hidden');
          } else {
            p.classList.add('hidden');
          }
        });
      });
    });
  }

  function initModal() {
    const modal = document.getElementById('catalog-modal');
    const openBtn = document.getElementById('open-catalog-modal');
    const closeBtn = document.getElementById('close-catalog-modal');
    const img = document.getElementById('catalog-img');
    const zoomLevelText = document.getElementById('zoom-level');

    if (!modal || !openBtn || !img) return;

    let currentScale = 1;
    let translateX = 0;
    let translateY = 0;
    let isDragging = false;
    let startX = 0;
    let startY = 0;
    let hasMoved = false;

    // Niveles de zoom cíclicos requeridos: 100% -> 125% -> 150% -> 100%
    const scaleSteps = [1, 1.25, 1.5, 2.0];
    let currentStepIndex = 0;

    function updateTransform() {
      img.style.transform = `translate(${translateX}px, ${translateY}px) scale(${currentScale})`;
      
      if (currentScale > 1) {
        img.style.cursor = isDragging ? 'grabbing' : 'grab';
      } else {
        img.style.cursor = 'zoom-in';
      }

      if (zoomLevelText) {
        zoomLevelText.textContent = `${Math.round(currentScale * 100)}%`;
      }
    }

    function resetZoomState() {
      currentStepIndex = 0;
      currentScale = scaleSteps[currentStepIndex];
      translateX = 0;
      translateY = 0;
      isDragging = false;
      updateTransform();
    }

    openBtn.addEventListener('click', () => {
      resetZoomState();
      modal.showModal();
    });

    closeBtn?.addEventListener('click', () => {
      modal.close();
    });

    modal.addEventListener('click', (e) => {
      const rect = modal.getBoundingClientRect();
      if (
        e.clientX < rect.left ||
        e.clientX > rect.right ||
        e.clientY < rect.top ||
        e.clientY > rect.bottom
      ) {
        modal.close();
      }
    });

    // Clic en la imagen para cambiar el zoom cíclicamente
    img.addEventListener('click', (e) => {
      if (hasMoved) return; // Evita hacer zoom si el usuario estaba arrastrando la imagen

      currentStepIndex = (currentStepIndex + 1) % scaleSteps.length;
      currentScale = scaleSteps[currentStepIndex];

      // Si vuelve al estado original (100%), reseteamos la posición
      if (currentScale === 1) {
        translateX = 0;
        translateY = 0;
      }

      updateTransform();
    });

    // Eventos para desplazamiento con clic sostenido (Pan/Drag)
    img.addEventListener('mousedown', (e) => {
      if (currentScale === 1) return;
      isDragging = true;
      hasMoved = false;
      startX = e.clientX - translateX;
      startY = e.clientY - translateY;
      img.style.cursor = 'grabbing';
      e.preventDefault();
    });

    window.addEventListener('mousemove', (e) => {
      if (!isDragging) return;
      hasMoved = true;
      translateX = e.clientX - startX;
      translateY = e.clientY - startY;
      updateTransform();
    });

    window.addEventListener('mouseup', () => {
      if (isDragging) {
        isDragging = false;
        updateTransform();
      }
    });
  }

  document.addEventListener('DOMContentLoaded', () => {
    initTabs();
    initModal();
  });
</script>