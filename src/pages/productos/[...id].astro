---
// src/pages/productos/[...id].astro
import LayoutBase from '../../layouts/LayoutBase.astro';
import { getCollection, render } from 'astro:content';
import { getProductoComercial } from '../../data/inventario';
import { getDirectContactUrl, getShareUrl } from '../../utils/whatsapp';
import HeroProducto from '../../components/producto/HeroProducto.astro';
import GuiaConsumoPanel from '../../components/producto/GuiaConsumoPanel.astro';
import GuiaComercialPanel from '../../components/producto/GuiaComercialPanel.astro';
import ModalCatalogo from '../../components/producto/ModalCatalogo.astro';

export async function getStaticPaths() {
  const productos = await getCollection('productos');
  return productos.map((producto) => ({
    params: { id: producto.id },
    props: { producto },
  }));
}

const { producto } = Astro.props;
const { Content } = await render(producto);
const { data } = producto;

const comercial = getProductoComercial(producto.id);
const rawBaseUrl = import.meta.env.BASE_URL;
const baseUrl = rawBaseUrl.endsWith('/') ? rawBaseUrl : `${rawBaseUrl}/`;

const productName = data.nombre;
const currentUrl = Astro.url.href;
const whatsappContactUrl = getDirectContactUrl(productName);
const whatsappShareUrl = getShareUrl(productName, currentUrl);
---

<LayoutBase 
  titulo={`${data.nombre} - Ficha Técnica`}
  descripcion={data.subtitulo}
  imagen={data.imagen?.src}
>
  <div class="mb-6 flex items-center justify-between">
    <a href={`${baseUrl}productos`} class="text-xs font-bold text-purple-700 dark:text-purple-400 hover:text-purple-900 dark:hover:text-purple-300 transition-colors">
      ← Volver al catálogo
    </a>
    {comercial?.codigo && (
      <span class="text-xs font-mono bg-slate-100 dark:bg-purple-950/60 px-2 py-1 rounded text-slate-500 dark:text-slate-400 border border-slate-200 dark:border-purple-900/40">
        SKU: {comercial.codigo}
      </span>
    )}
  </div>

  <HeroProducto 
    producto={producto} 
    comercial={comercial} 
    whatsappContactUrl={whatsappContactUrl} 
    whatsappShareUrl={whatsappShareUrl} 
  />

  {/* Pestañas de Navegación */}
  <div class="flex border border-slate-200/80 dark:border-purple-950/60 mb-8 bg-slate-100 dark:bg-purple-950/30 p-1.5 rounded-2xl max-w-md mx-auto">
    <button
      id="tab-consumidor"
      class="tab-btn flex-1 py-2.5 px-4 rounded-xl text-sm font-bold transition-all duration-200 cursor-pointer bg-white dark:bg-purple-900 text-purple-900 dark:text-white shadow-xs"
      data-target="panel-consumidor"
    >
      🥤 Guía de Uso
    </button>
    <button
      id="tab-empresario"
      class="tab-btn flex-1 py-2.5 px-4 rounded-xl text-sm font-bold transition-all duration-200 cursor-pointer text-slate-700 dark:text-slate-400 hover:text-purple-900 dark:hover:text-white hover:bg-white/60 dark:hover:bg-purple-950/40"
      data-target="panel-empresario"
    >
      💼 Guía Comercial
    </button>
  </div>

  <div id="panel-consumidor" class="tab-panel">
    <GuiaConsumoPanel data={data}>
      <Content />
    </GuiaConsumoPanel>
  </div>

  <div id="panel-empresario" class="tab-panel hidden">
    <GuiaComercialPanel data={data} comercial={comercial} />
  </div>

  <ModalCatalogo data={data} />
</LayoutBase>

<script is:inline>
  function initTabs() {
    const buttons = document.querySelectorAll('.tab-btn');
    const panels = document.querySelectorAll('.tab-panel');

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetId = btn.getAttribute('data-target');

        buttons.forEach((b) => {
          b.classList.remove('bg-white', 'dark:bg-purple-900', 'text-purple-900', 'dark:text-white', 'shadow-xs');
          b.classList.add('text-slate-700', 'dark:text-slate-400', 'hover:text-purple-900', 'dark:hover:text-white', 'hover:bg-white/60', 'dark:hover:bg-purple-950/40');
        });

        btn.classList.add('bg-white', 'dark:bg-purple-900', 'text-purple-900', 'dark:text-white', 'shadow-xs');
        btn.classList.remove('text-slate-700', 'dark:text-slate-400', 'hover:text-purple-900', 'dark:hover:text-white', 'hover:bg-white/60', 'dark:hover:bg-purple-950/40');

        panels.forEach((p) => {
          if (p.id === targetId) {
            p.classList.remove('hidden');
          } else {
            p.classList.add('hidden');
          }
        });
      });
    });
  }

  function initModal() {
    const modal = document.getElementById('catalog-modal');
    const openBtn = document.getElementById('open-catalog-modal');
    const closeBtn = document.getElementById('close-catalog-modal');
    const img = document.getElementById('catalog-img');
    const zoomLevelText = document.getElementById('zoom-level');

    if (!modal || !openBtn || !img) return;

    let currentScale = 1;
    let translateX = 0;
    let translateY = 0;
    let isDragging = false;
    let startX = 0;
    let startY = 0;
    let hasMoved = false;

    const scaleSteps = [1, 1.25, 1.5, 2.0];
    let currentStepIndex = 0;

    function updateTransform() {
      img.style.transform = `translate(${translateX}px, ${translateY}px) scale(${currentScale})`;
      if (currentScale > 1) {
        img.style.cursor = isDragging ? 'grabbing' : 'grab';
      } else {
        img.style.cursor = 'zoom-in';
      }
      if (zoomLevelText) {
        zoomLevelText.textContent = `${Math.round(currentScale * 100)}%`;
      }
    }

    function resetZoomState() {
      currentStepIndex = 0;
      currentScale = scaleSteps[currentStepIndex];
      translateX = 0;
      translateY = 0;
      isDragging = false;
      updateTransform();
    }

    openBtn.addEventListener('click', () => {
      resetZoomState();
      modal.showModal();
    });

    closeBtn?.addEventListener('click', () => {
      modal.close();
    });

    modal.addEventListener('click', (e) => {
      const rect = modal.getBoundingClientRect();
      if (e.clientX < rect.left || e.clientX > rect.right || e.clientY < rect.top || e.clientY > rect.bottom) {
        modal.close();
      }
    });

    img.addEventListener('click', () => {
      if (hasMoved) return;
      currentStepIndex = (currentStepIndex + 1) % scaleSteps.length;
      currentScale = scaleSteps[currentStepIndex];
      if (currentScale === 1) {
        translateX = 0;
        translateY = 0;
      }
      updateTransform();
    });

    img.addEventListener('mousedown', (e) => {
      if (currentScale === 1) return;
      isDragging = true;
      hasMoved = false;
      startX = e.clientX - translateX;
      startY = e.clientY - translateY;
      img.style.cursor = 'grabbing';
      e.preventDefault();
    });

    window.addEventListener('mousemove', (e) => {
      if (!isDragging) return;
      hasMoved = true;
      translateX = e.clientX - startX;
      translateY = e.clientY - startY;
      updateTransform();
    });

    window.addEventListener('mouseup', () => {
      if (isDragging) {
        isDragging = false;
        updateTransform();
      }
    });
  }

  document.addEventListener('DOMContentLoaded', () => {
    initTabs();
    initModal();
  });

  document.addEventListener('DOMContentLoaded', () => {
    const defaultPhone = "50587291404";
    const urlParams = new URLSearchParams(window.location.search);
    const refPhone = urlParams.get('w') || urlParams.get('ref');
    const savedMyPhone = localStorage.getItem('my_whatsapp_phone');

    const activePhone = (savedMyPhone || refPhone || defaultPhone).replace(/\D/g, '');

    const contactBtn = document.getElementById('whatsapp-contact-btn');
    if (contactBtn) {
      const productName = contactBtn.getAttribute('data-product-name') || '';
      const message = `Hola, vi la información en MyOmniGuide y me interesa asesoría sobre el producto *${productName}*.`;
      contactBtn.href = `https://wa.me/${activePhone}?text=${encodeURIComponent(message)}`;
    }

    const shareBtn = document.getElementById('whatsapp-share-btn');
    if (shareBtn) {
      const productName = shareBtn.getAttribute('data-product-name') || '';
      const cleanUrl = window.location.href.split('?')[0];
      const referralUrl = `${cleanUrl}?w=${activePhone}`;
      const message = `¡Hola! Te comparto la ficha técnica oficial de *${productName}* en MyOmniGuide:\n\n${referralUrl}`;
      shareBtn.href = `https://api.whatsapp.com/send?text=${encodeURIComponent(message)}`;
    }
  });
</script>