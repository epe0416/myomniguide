---
// src/pages/combos.astro
import LayoutBase from '../layouts/LayoutBase.astro';
import { getCollection, getEntry } from 'astro:content';
import { getProductoComercial } from '../data/inventario';
import ComboCard from '../components/combos/ComboCard.astro';
import ComboEmptyState from '../components/combos/ComboEmptyState.astro';

const rawBaseUrl = import.meta.env.BASE_URL;
const baseUrl = rawBaseUrl.endsWith('/') ? rawBaseUrl : `${rawBaseUrl}/`;

const todosLosCombos = await getCollection('combos');

const combosConProductos = await Promise.all(
  todosLosCombos.map(async (combo) => {
    const productosResueltos = (
      await Promise.all(
        combo.data.productos.map(async (p) => {
          const isObject = typeof p === 'object' && p !== null && 'item' in p;
          const ref = isObject ? p.item : p;
          const cantidad = isObject ? (p.cantidad ?? 1) : 1;

          const prod = await getEntry(ref);
          if (!prod) return null;

          const comercial = getProductoComercial(prod.id);

          return {
            ...prod,
            cantidad,
            comercial,
            disponibleNIO: !!comercial?.nio,
            disponibleUSA: !!comercial?.usa,
          };
        })
      )
    ).filter((item): item is NonNullable<typeof item> => item !== null);

    const puntosNIOTotal = productosResueltos
      .filter((item) => item.disponibleNIO)
      .reduce((acc, item) => acc + (item.comercial?.nio?.puntos ?? 0) * item.cantidad, 0);

    const precioNIOTotal = productosResueltos
      .filter((item) => item.disponibleNIO)
      .reduce((acc, item) => acc + (item.comercial?.nio?.precio ?? 0) * item.cantidad, 0);

    const puntosUSDTotal = productosResueltos
      .filter((item) => item.disponibleUSA)
      .reduce((acc, item) => acc + (item.comercial?.usa?.puntos ?? 0) * item.cantidad, 0);

    const precioUSDTotal = productosResueltos
      .filter((item) => item.disponibleUSA)
      .reduce((acc, item) => acc + (item.comercial?.usa?.precio ?? 0) * item.cantidad, 0);

    return {
      combo,
      productos: productosResueltos,
      puntosNIOTotal,
      puntosUSDTotal,
      precioNIOTotal,
      precioUSDTotal,
    };
  })
);
---

<LayoutBase titulo="Combos Sugeridos">
  <!-- Script bloqueante síncrono para prevenir FOUC -->
  <script is:inline>
    (function () {
      let moneda = localStorage.getItem('moneda_pref') || 'NIO';
      if (moneda === 'USD') moneda = 'USA';
      document.documentElement.setAttribute('data-market', moneda.toLowerCase());
    })();
  </script>

  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-12">
    <!-- Encabezado -->
    <div class="mb-10 text-center max-w-3xl mx-auto">
      <span class="inline-block px-3 py-1 bg-purple-100 dark:bg-purple-950/80 text-purple-900 dark:text-purple-300 rounded-full text-xs font-bold uppercase tracking-wider mb-3">
        Protocolos Integrales
      </span>
      <h1 class="text-3xl md:text-5xl font-black text-slate-950 dark:text-white tracking-tight mb-3">
        Combos y Paquetes Sugeridos
      </h1>
      <p class="text-slate-600 dark:text-slate-300 text-sm md:text-base">
        Combinaciones estratégicas formuladas para potenciar resultados por objetivo de bienestar. Haz clic en cualquier combo para ver su protocolo completo.
      </p>
    </div>

    <!-- Componente Estado Vacío (Fuera del grid para ocupar todo el ancho) -->
    <ComboEmptyState baseUrl={baseUrl} />

    <!-- Grid de Combos -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8" id="grid-combos">
      {combosConProductos.map((props) => (
        <ComboCard {...props} baseUrl={baseUrl} />
      ))}
    </div>
  </main>
</LayoutBase>

<style is:global>
  /* Filtrado nativo síncrono por atributo HTML global */
  html[data-market="nio"] .combo-card[data-has-nio="false"],
  html[data-market="usa"] .combo-card[data-has-usa="false"],
  html[data-market="nio"] .combo-product-item[data-has-nio="false"],
  html[data-market="usa"] .combo-product-item[data-has-usa="false"],
  .combo-card.market-hidden,
  .combo-product-item.region-hidden {
    display: none !important;
  }

  dialog[open] {
    animation: modalScaleIn 0.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  @keyframes modalScaleIn {
    from { 
      opacity: 0; 
      transform: scale(0.96); 
    }
    to { 
      opacity: 1; 
      transform: scale(1); 
    }
  }
</style>

<script is:inline>
  function sincronizarMercadoYCombos() {
    let moneda = localStorage.getItem('moneda_pref') || 'NIO';
    if (moneda === 'USD') moneda = 'USA';
    const marketKey = moneda.toLowerCase();

    // 1. Actualizar el atributo HTML global
    document.documentElement.setAttribute('data-market', marketKey);

    // 2. Sincronizar Badges de Puntos
    const ptsKey = `data-${marketKey}-pts`;
    document.querySelectorAll('.pts-badge').forEach((badge) => {
      const val = badge.getAttribute(ptsKey);
      const target = badge.querySelector('.pts-value');
      if (val && target) {
        target.textContent = val;
      }
    });

    // 3. Ocultar TARJETAS DE COMBOS según mercado y contar las visibles
    let visibleCount = 0;
    const cards = document.querySelectorAll('.combo-card');
    
    cards.forEach((card) => {
      const hasNio = card.getAttribute('data-has-nio') === 'true';
      const hasUsa = card.getAttribute('data-has-usa') === 'true';
      const disponible = moneda === 'USA' ? hasUsa : hasNio;

      if (!disponible) {
        card.classList.add('market-hidden');
      } else {
        card.classList.remove('market-hidden');
        visibleCount++;
      }
    });

    // 4. Alternar visibilidad entre el Estado Vacío (Empty State) y la Grilla de Combos
    const emptyState = document.getElementById('empty-state-combos');
    const gridCombos = document.getElementById('grid-combos');

    if (visibleCount === 0) {
      if (emptyState) emptyState.classList.remove('hidden');
      if (gridCombos) gridCombos.classList.add('hidden');
    } else {
      if (emptyState) emptyState.classList.add('hidden');
      if (gridCombos) gridCombos.classList.remove('hidden');
    }

    // 5. Ocultar productos individuales no disponibles dentro de los combos
    document.querySelectorAll('.combo-product-item').forEach((item) => {
      const hasNio = item.getAttribute('data-has-nio') === 'true';
      const hasUsa = item.getAttribute('data-has-usa') === 'true';
      const disponible = moneda === 'USA' ? hasUsa : hasNio;

      if (!disponible) {
        item.classList.add('region-hidden');
      } else {
        item.classList.remove('region-hidden');
      }
    });
  }

  function initCombosInteractions() {
    sincronizarMercadoYCombos();

    // 1. Evento para abrir el modal al hacer clic en la tarjeta
    document.querySelectorAll('.combo-card').forEach((card) => {
      if (card.dataset.hasClickListener) return;
      card.dataset.hasClickListener = 'true';

      card.addEventListener('click', (e) => {
        const target = e.target;
        
        // Ignorar clics en enlaces, botones O interacciones dentro/sobre el modal
        if (
          target.closest('a') || 
          target.closest('button') || 
          target.closest('dialog')
        ) {
          return;
        }

        const comboId = card.getAttribute('data-combo-id');
        const modal = document.getElementById(`modal-${comboId}`);
        if (modal && typeof modal.showModal === 'function') {
          modal.showModal();
        }
      });
    });

    // 2. Evento para cerrar modal desde los botones internos (✕ y Cerrar)
    document.querySelectorAll('[data-close-modal]').forEach((btn) => {
      if (btn.dataset.hasCloseListener) return;
      btn.dataset.hasCloseListener = 'true';

      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const modalId = btn.getAttribute('data-close-modal');
        const modal = document.getElementById(modalId);
        if (modal && typeof modal.close === 'function') {
          modal.close();
        }
      });
    });

    // 3. Cierre por Clic en el Backdrop (Fondo oscuro)
    document.querySelectorAll('dialog.dialog-combo').forEach((dialog) => {
      if (dialog.dataset.hasBackdropListener) return;
      dialog.dataset.hasBackdropListener = 'true';

      dialog.addEventListener('click', (e) => {
        if (e.target === dialog) {
          e.stopPropagation();
          dialog.close();
        }
      });
    });
  }

  document.addEventListener('DOMContentLoaded', initCombosInteractions);
  window.addEventListener('currency-changed', sincronizarMercadoYCombos);
</script>