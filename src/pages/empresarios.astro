---
import LayoutBase from '../layouts/LayoutBase.astro';
import { CONFIG_NEGOCIO } from '../data/config';
import PanelPasos from '../components/empresarios/PanelPasos.astro';
import PanelDescuentos from '../components/empresarios/PanelDescuentos.astro';
import PanelRangos from '../components/empresarios/PanelRangos.astro';
import PanelRed from '../components/empresarios/PanelRed.astro';
import PanelAfiliado from '../components/empresarios/PanelAfiliado.astro';

if (!CONFIG_NEGOCIO.mostrarNegocios) {
  return Astro.redirect(import.meta.env.BASE_URL);
}
---

<LayoutBase 
  titulo="Guía para Empresarios - Plan de Compensación"
  descripcion="Domina el Multidesarrollo Omnilife, los 5 Pasos de Oro y el Plan de Compensación con herramientas interactivas."
>
  <div class="mb-8 text-center max-w-3xl mx-auto">
    <span class="text-xs font-bold tracking-wider text-purple-700 dark:text-purple-400 bg-purple-100 dark:bg-purple-950/80 px-3 py-1 rounded-md uppercase inline-block mb-3">
      💼 Centro de Negocio y Liderazgo
    </span>
    <h1 class="text-3xl md:text-5xl font-extrabold text-slate-950 dark:text-white mb-4">
      Multidesarrollo Omnilife
    </h1>
    <p class="text-slate-700 dark:text-slate-300 text-base md:text-lg">
      Comprende de forma clara, interactiva y estratégica cómo funciona el plan de compensación, la escala de descuentos y los incentivos de crecimiento.
    </p>
  </div>

  <!-- Pestañas de Navegación Interactiva -->
  <div class="flex flex-wrap border border-slate-200/80 dark:border-purple-950/60 mb-8 bg-slate-100 dark:bg-purple-950/30 p-1.5 rounded-2xl max-w-3xl mx-auto gap-2">
    <button class="emp-tab-btn flex-1 py-2.5 px-3 rounded-xl text-xs sm:text-sm font-bold transition-all duration-200 cursor-pointer bg-white dark:bg-purple-900 text-purple-900 dark:text-white shadow-xs" data-target="panel-pasos">
      ⭐ 5 Pasos
    </button>
    <button class="emp-tab-btn flex-1 py-2.5 px-3 rounded-xl text-xs sm:text-sm font-bold transition-all duration-200 cursor-pointer text-slate-700 dark:text-slate-400 hover:text-purple-900 dark:hover:text-white" data-target="panel-calculadora">
      📊 Descuento
    </button>
    <button class="emp-tab-btn flex-1 py-2.5 px-3 rounded-xl text-xs sm:text-sm font-bold transition-all duration-200 cursor-pointer text-slate-700 dark:text-slate-400 hover:text-purple-900 dark:hover:text-white" data-target="panel-rangos">
      🏆 Niveles
    </button>
    <button class="emp-tab-btn flex-1 py-2.5 px-3 rounded-xl text-xs sm:text-sm font-bold transition-all duration-200 cursor-pointer text-slate-700 dark:text-slate-400 hover:text-purple-900 dark:hover:text-white" data-target="panel-ganancias">
      💰 Red
    </button>
    <button class="emp-tab-btn flex-1 py-2.5 px-3 rounded-xl text-xs sm:text-sm font-bold transition-all duration-200 cursor-pointer text-slate-700 dark:text-slate-400 hover:text-purple-900 dark:hover:text-white" data-target="panel-afiliado">
      🔗 Mi Enlace
    </button>
  </div>

  <!-- Paneles Modulares -->
  <PanelPasos />
  <PanelDescuentos />
  <PanelRangos />
  <PanelRed />
  <PanelAfiliado />
</LayoutBase>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    // 1. Pestañas de Navegación
    const buttons = document.querySelectorAll('.emp-tab-btn');
    const panels = document.querySelectorAll('.emp-panel');

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetId = btn.getAttribute('data-target');

        buttons.forEach((b) => {
          b.classList.remove('bg-white', 'dark:bg-purple-900', 'text-purple-900', 'dark:text-white', 'shadow-xs');
          b.classList.add('text-slate-700', 'dark:text-slate-400', 'hover:text-purple-900', 'dark:hover:text-white');
        });

        btn.classList.add('bg-white', 'dark:bg-purple-900', 'text-purple-900', 'dark:text-white', 'shadow-xs');
        btn.classList.remove('text-slate-700', 'dark:text-slate-400', 'hover:text-purple-900', 'dark:hover:text-white');

        panels.forEach((p) => {
          if (p.id === targetId) {
            p.classList.remove('hidden');
          } else {
            p.classList.add('hidden');
          }
        });
      });
    });

    // 2. Simulador de Escala de Descuentos (40%)
    const slider = document.getElementById('puntos-slider');
    const puntosVal = document.getElementById('puntos-val');
    const descPorcentaje = document.getElementById('desc-porcentaje');
    const descMensaje = document.getElementById('desc-mensaje');

    slider?.addEventListener('input', (e) => {
      const val = parseInt(e.target.value);
      if (puntosVal) puntosVal.textContent = val;

      let desc = '25%';
      let msg = 'Acumula al menos 1,000 puntos para subir al 30% de descuento.';

      if (val >= 4000) {
        desc = '40%';
        msg = '¡Felicidades! Has alcanzado el descuento máximo del 40% (aplicando reglas de múltiplos de mil).';
      } else if (val >= 2000) {
        desc = '35%';
        msg = '¡Excelente! Estás muy cerca de la meta del 40%. Sigue sumando volumen.';
      } else if (val >= 1000) {
        desc = '30%';
        msg = '¡Buen trabajo! Has escalado al 30%. Tu siguiente meta es llegar a 2,000 puntos.';
      }

      if (descPorcentaje) descPorcentaje.textContent = desc;
      if (descMensaje) descMensaje.textContent = msg;
    });

    // 3. Inspector Interactivo de Niveles
    const categoryData = {
      bronce: [
        { key: "b", title: "Bronce", badge: "Nivel Inicial", titles: "Ninguno", pp: "100", pg: "-", pld: "-", la: "-", n1: "10%", n2n3: "No disponible", extra: "No disponible" },
        { key: "ba", title: "Bronce Activo", badge: "Nivel 1", titles: "Ninguno", pp: "300", pg: "-", pld: "-", la: "-", n1: "10% (5% Inicio)", n2n3: "No disponible", extra: "No disponible" },
        { key: "bp", title: "Bronce Premier", badge: "Nivel 2", titles: "Ninguno", pp: "300", pg: "1,500", pld: "-", la: "1 Línea", n1: "10% (8% N1)", n2n3: "No disponible", extra: "No disponible" },
        { key: "be", title: "Bronce Elite", badge: "Nivel 3", titles: "Ninguno", pp: "500", pg: "2,000", pld: "-", la: "1 Línea", n1: "10%", n2n3: "No disponible", extra: "No disponible" },
        { key: "bs", title: "Bronce Supreme", badge: "Nivel 4", titles: "Ninguno", pp: "1,000", pg: "4,000", pld: "-", la: "3 Líneas", n1: "10%", n2n3: "N2: 5%", extra: "No disponible" }
      ],
      plata: [
        { key: "pp", title: "Plata Premier", badge: "Liderazgo Inicial", titles: "2 BA + 2 BP", pp: "1,500", pg: "7,000", pld: "-", la: "4 Líneas", n1: "10%", n2n3: "N2: 8%", extra: "No disponible" },
        { key: "pe", title: "Plata Elite", badge: "Liderazgo Intermedio", titles: "2 BP + 2 BE", pp: "2,000", pg: "10,000", pld: "-", la: "4 Líneas", n1: "10%", n2n3: "N2: 8% | N3: 4%", extra: "No disponible" },
        { key: "ps", title: "Plata Supreme", badge: "Liderazgo Avanzado", titles: "4 BE", pp: "2,500", pg: "10,000", pld: "12,000", la: "4 Líneas", n1: "10%", n2n3: "N2: 8% | N3: 6%", extra: "CCE (Constructor): 2%" }
      ],
      oro: [
        { key: "op", title: "Oro Premier", badge: "Oro 1", titles: "2 BS + 2 PP", pp: "2,500", pg: "10,000", pld: "34,000", la: "4 Líneas", n1: "10%", n2n3: "N2: 8% | N3: 6%", extra: "CCE: 2% | Gen G1: 3%" },
        { key: "oe", title: "Oro Elite", badge: "Oro 2", titles: "2 PE + 2 PS", pp: "2,500", pg: "10,000", pld: "80,000", la: "4 Líneas", n1: "10%", n2n3: "N2: 8% | N3: 6%", extra: "CCE: 2% | Gen G1-G2 (3%-4%)" },
        { key: "os", title: "Oro Supreme", badge: "Oro Máximo", titles: "2 PS + 2 OP", pp: "2,500", pg: "10,000", pld: "200,000", la: "4 Líneas", n1: "10%", n2n3: "N2: 8% | N3: 6%", extra: "CCE: 2% | Gen G1-G3 (3%-5%)" }
      ],
      diamante: [
        { key: "dp", title: "Diamante Premier", badge: "Diamante 1", titles: "3 PS + 2 OE", pp: "2,500", pg: "10,000", pld: "500,000", la: "5 Líneas", n1: "10%", n2n3: "N2: 8% | N3: 6%", extra: "CCE: 2% | Gen G1-G4" },
        { key: "de", title: "Diamante Elite", badge: "Diamante 2", titles: "4 PS + 2 OS", pp: "2,500", pg: "10,000", pld: "1,200,000", la: "6 Líneas", n1: "10%", n2n3: "N2: 8% | N3: 6%", extra: "CCE: 2% | Gen G1-G5" },
        { key: "ds", title: "Diamante Supreme", badge: "Diamante Máximo", titles: "4 PS + 2 DP", pp: "2,500", pg: "10,000", pld: "3,000,000", la: "6 Líneas", n1: "10%", n2n3: "N2: 8% | N3: 6%", extra: "CCE: 2% | Gen G1-G6 + Diamantes" },
        { key: "ddp", title: "Doble Diamante Premier", badge: "Doble Diamante 1", titles: "4 PS + 1 OE + 2 DE", pp: "2,500", pg: "10,000", pld: "8,000,000", la: "7 Líneas", n1: "10%", n2n3: "N2: 8% | N3: 6%", extra: "CCE: 2% | Gen G1-G6 + Diamantes G1-G2" },
        { key: "dde", title: "Doble Diamante Elite", badge: "Doble Diamante 2", titles: "4 PS + 2 OS + 2 DS", pp: "2,500", pg: "10,000", pld: "20,000,000", la: "8 Líneas", n1: "10%", n2n3: "N2: 8% | N3: 6%", extra: "CCE: 2% | Gen G1-G6 + Diamantes G1-G3" },
        { key: "dds", title: "Doble Diamante Supreme", badge: "Doble Diamante Máx", titles: "4 PS + 3 DP + 2 DDP", pp: "2,500", pg: "10,000", pld: "50,000,000", la: "9 Líneas", n1: "10%", n2n3: "N2: 8% | N3: 6%", extra: "CCE: 2% | Gen G1-G6 + Diamantes" },
        { key: "td", title: "Triple Diamante", badge: "Cúspide del Negocio", titles: "4 PS + 4 DE + 2 DDE", pp: "2,500", pg: "10,000", pld: "50,000,000+", la: "10 Líneas", n1: "10%", n2n3: "N2: 8% | N3: 6%", extra: "CCE: 2% | Gen G1-G6 (3%) + Diamantes" }
      ]
    };

    const categoryBtns = document.querySelectorAll('.category-btn');
    const subRankSelector = document.getElementById('sub-rank-selector');
    const subButtonsContainer = document.getElementById('sub-buttons-container');
    const categoryTitleSpan = document.getElementById('category-title-span');

    const rankDisplayCard = document.getElementById('rank-display-card');
    const cardBadge = document.getElementById('card-badge');
    const cardTitle = document.getElementById('card-title');
    const cardTitles = document.getElementById('card-titles');
    const reqPp = document.getElementById('req-pp');
    const reqPg = document.getElementById('req-pg');
    const reqPld = document.getElementById('req-pld');
    const reqLa = document.getElementById('req-la');
    const gainN1 = document.getElementById('gain-n1');
    const gainN2N3 = document.getElementById('gain-n2n3');
    const gainExtra = document.getElementById('gain-extra');

    function updateCardData(data) {
      if (!rankDisplayCard) return;
      rankDisplayCard.style.opacity = '0';
      setTimeout(() => {
        if (cardBadge) cardBadge.textContent = data.badge;
        if (cardTitle) cardTitle.textContent = data.title;
        if (cardTitles) cardTitles.textContent = data.titles;
        if (reqPp) reqPp.textContent = data.pp;
        if (reqPg) reqPg.textContent = data.pg;
        if (reqPld) reqPld.textContent = data.pld;
        if (reqLa) reqLa.textContent = data.la;
        if (gainN1) gainN1.textContent = data.n1;
        if (gainN2N3) gainN2N3.textContent = data.n2n3;
        if (gainExtra) gainExtra.textContent = data.extra;
        rankDisplayCard.style.opacity = '1';
      }, 150);
    }

    function loadCategory(categoryKey, categoryDisplayName) {
      const items = categoryData[categoryKey];
      if (!items) return;

      if (categoryTitleSpan) categoryTitleSpan.textContent = categoryDisplayName;
      subButtonsContainer.innerHTML = '';

      items.forEach((item, index) => {
        const btn = document.createElement('button');
        btn.className = `sub-rank-btn px-4 py-2 rounded-xl text-xs font-bold transition-all cursor-pointer border ${
          index === 0 
            ? 'bg-purple-900 text-white border-purple-700 shadow-xs' 
            : 'bg-slate-100 dark:bg-purple-950/40 text-slate-700 dark:text-slate-300 border-slate-200 dark:border-purple-900/50 hover:border-purple-500'
        }`;
        btn.textContent = item.title;

        btn.addEventListener('click', () => {
          document.querySelectorAll('.sub-rank-btn').forEach((b) => {
            b.classList.remove('bg-purple-900', 'text-white', 'border-purple-700', 'shadow-xs');
            b.classList.add('bg-slate-100', 'dark:bg-purple-950/40', 'text-slate-700', 'dark:text-slate-300', 'border-slate-200', 'dark:border-purple-900/50');
          });
          btn.classList.add('bg-purple-900', 'text-white', 'border-purple-700', 'shadow-xs');
          btn.classList.remove('bg-slate-100', 'dark:bg-purple-950/40', 'text-slate-700', 'dark:text-slate-300', 'border-slate-200', 'dark:border-purple-900/50');

          updateCardData(item);
        });

        subButtonsContainer.appendChild(btn);
      });

      subRankSelector.classList.remove('hidden');
      setTimeout(() => {
        subRankSelector.classList.remove('scale-95', 'opacity-0');
        subRankSelector.classList.add('scale-100', 'opacity-100');
      }, 10);

      updateCardData(items[0]);
    }

    categoryBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const cat = btn.getAttribute('data-category');
        const displayName = btn.querySelector('.font-extrabold').textContent;

        categoryBtns.forEach((b) => {
          b.classList.remove('bg-purple-900', 'text-white', 'border-purple-700', 'shadow-md');
          b.classList.add('bg-slate-100', 'dark:bg-purple-950/40', 'text-slate-700', 'dark:text-slate-300', 'border-slate-200', 'dark:border-purple-900/50', 'hover:border-purple-500', 'hover:shadow-sm');
        });
        btn.classList.add('bg-purple-900', 'text-white', 'border-purple-700', 'shadow-md');
        btn.classList.remove('bg-slate-100', 'dark:bg-purple-950/40', 'text-slate-700', 'dark:text-slate-300', 'border-slate-200', 'dark:border-purple-900/50', 'hover:border-purple-500', 'hover:shadow-sm');

        loadCategory(cat, displayName);
      });
    });

    loadCategory('bronce', 'Bronce');

    // 4. Calculadora de Comisiones de Red
    const n1Slider = document.getElementById('n1-slider');
    const n2Slider = document.getElementById('n2-slider');
    const n3Slider = document.getElementById('n3-slider');
    const n1Val = document.getElementById('n1-val');
    const n2Val = document.getElementById('n2-val');
    const n3Val = document.getElementById('n3-val');
    const totalComision = document.getElementById('total-comision');

    function calcularRed() {
      const p1 = parseInt(n1Slider?.value || 0);
      const p2 = parseInt(n2Slider?.value || 0);
      const p3 = parseInt(n3Slider?.value || 0);

      if (n1Val) n1Val.textContent = `${p1.toLocaleString()} PTS`;
      if (n2Val) n2Val.textContent = `${p2.toLocaleString()} PTS`;
      if (n3Val) n3Val.textContent = `${p3.toLocaleString()} PTS`;

      const comisionN1 = p1 * 0.10 * 1.25; 
      const comisionN2 = p2 * 0.08 * 1.25;
      const comisionN3 = p3 * 0.06 * 1.25;

      const total = comisionN1 + comisionN2 + comisionN3;

      if (totalComision) {
        totalComision.textContent = `$${total.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })} USD`;
      }
    }

    n1Slider?.addEventListener('input', calcularRed);
    n2Slider?.addEventListener('input', calcularRed);
    n3Slider?.addEventListener('input', calcularRed);

    calcularRed();

    // 5. Configuración de WhatsApp de Afiliado en LocalStorage
    const inputAfiliado = document.getElementById('input-afiliado-whatsapp');
    const btnGuardar = document.getElementById('btn-guardar-whatsapp');
    const feedback = document.getElementById('afiliado-feedback');

    if (inputAfiliado) {
      const savedNumber = localStorage.getItem('my_whatsapp_phone');
      if (savedNumber) {
        inputAfiliado.value = savedNumber;
      }
    }

    btnGuardar?.addEventListener('click', () => {
      const val = inputAfiliado?.value.trim().replace(/\D/g, '');
      if (val && val.length >= 8) {
        localStorage.setItem('my_whatsapp_phone', val);
        if (feedback) {
          feedback.classList.remove('hidden');
          setTimeout(() => feedback.classList.add('hidden'), 4000);
        }
      } else {
        alert('Por favor ingresa un número de WhatsApp válido.');
      }
    });
  });
</script>